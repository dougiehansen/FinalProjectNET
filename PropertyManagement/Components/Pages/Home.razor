@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject IPropertyAccessService AccessService
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.EntityFrameworkCore
@using PropertyManagement.Data
@using PropertyManagement.Models
@using PropertyManagement.Services
@implements IDisposable

<PageTitle>Dashboard - PropertyMS</PageTitle>

<div class="page-wrap">
    <h1 class="page-title">Dashboard</h1>

    @* Administrator: revenue + occupancy + outstanding + expiry *@
    @if (IsAdmin)
    {
        <section class="stats-grid g4">
            <div class="stat-card">
                <div class="stat-label">Monthly Revenue</div>
                <div class="stat-value" style="color:#16a34a;">€@monthlyRevenue.ToString("N0")</div>
                <div class="stat-sub">@occupiedUnits of @totalUnits units occupied</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Occupancy Rate</div>
                <div class="stat-value" style="color:#2563eb;">@OccupancyPct%</div>
                <div class="stat-sub">@(totalUnits - occupiedUnits) vacant @(totalUnits - occupiedUnits == 1 ? "unit" : "units")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Outstanding Balance</div>
                <div class="stat-value" style="color:@(totalOutstanding > 0 ? "#dc2626" : "#16a34a");">€@totalOutstanding.ToString("N0")</div>
                <div class="stat-sub">@overdueCount @(overdueCount == 1 ? "tenant" : "tenants") overdue</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Expiring Soon</div>
                <div class="stat-value" style="color:@(expiringSoon > 0 ? "#b45309" : "var(--text)");">@expiringSoon</div>
                <div class="stat-sub">@(pendingSignatures > 0 ? $"{pendingSignatures} pending signature{(pendingSignatures == 1 ? "" : "s")}" : "leases in next 60 days")</div>
            </div>
        </section>
    }

    @* Property Manager: properties + units + expiring + pending signatures *@
    else if (IsManager)
    {
        <section class="stats-grid g4">
            <div class="stat-card">
                <div class="stat-label">Properties</div>
                <div class="stat-value" style="color:#2563eb;">@totalProperties</div>
                <div class="stat-sub">Active properties</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Units</div>
                <div class="stat-value">@totalUnits</div>
                <div class="stat-sub">@occupiedUnits occupied · @(totalUnits - occupiedUnits) vacant</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Expiring Soon</div>
                <div class="stat-value" style="color:@(expiringSoon > 0 ? "#b45309" : "var(--text)");">@expiringSoon</div>
                <div class="stat-sub">leases ending in 60 days</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Pending Signatures</div>
                <div class="stat-value" style="color:@(pendingSignatures > 0 ? "#b45309" : "var(--text)");">@pendingSignatures</div>
                <div class="stat-sub">awaiting tenant sign-off</div>
            </div>
        </section>
    }

    @* Accounting Team: revenue + outstanding + overdue count + payments this month *@
    else if (IsAccounting)
    {
        <section class="stats-grid g4">
            <div class="stat-card">
                <div class="stat-label">Monthly Revenue</div>
                <div class="stat-value" style="color:#16a34a;">€@monthlyRevenue.ToString("N0")</div>
                <div class="stat-sub">from @occupiedUnits occupied units</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Outstanding Balance</div>
                <div class="stat-value" style="color:@(totalOutstanding > 0 ? "#dc2626" : "#16a34a");">€@totalOutstanding.ToString("N0")</div>
                <div class="stat-sub">across all active leases</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Overdue Tenants</div>
                <div class="stat-value" style="color:@(overdueCount > 0 ? "#dc2626" : "#16a34a");">@overdueCount</div>
                <div class="stat-sub">@(activeLeases - overdueCount) paid up</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Payments This Month</div>
                <div class="stat-value" style="color:#2563eb;">@paymentsThisMonth</div>
                <div class="stat-sub">@DateTime.Today.ToString("MMMM yyyy")</div>
            </div>
        </section>
    }

    @* Fallback *@
    else
    {
        <section class="stats-grid g4">
            <div class="stat-card">
                <div class="stat-label">Properties</div>
                <div class="stat-value">@totalProperties</div>
                <div class="stat-sub">Active properties</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Units</div>
                <div class="stat-value">@totalUnits</div>
                <div class="stat-sub">@occupiedUnits occupied</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Active Leases</div>
                <div class="stat-value">@activeLeases</div>
                <div class="stat-sub">Current tenants</div>
            </div>
        </section>
    }

    <div class="sig-grid">
        <div class="sig-card" id="ecb-rate">
            <div class="stat-label">ECB Interest Rate</div>
            <div class="sig-value">…</div>
            <div class="stat-sub">Loading…</div>
            <div class="sig-date"></div>
        </div>
        <div class="sig-card" id="hicp-value">
            <div class="stat-label">Euro Area Inflation (HICP)</div>
            <div class="sig-value">…</div>
            <div class="stat-sub">Loading…</div>
            <div class="sig-date"></div>
        </div>
        <div class="sig-card" id="eu-sentiment">
            <div class="stat-label">EU Economic Sentiment (IE)</div>
            <div class="sig-value">…</div>
            <div class="stat-sub">Loading…</div>
            <div class="sig-date"></div>
        </div>
        <div class="sig-card" id="euribor-value">
            <div class="stat-label">EURIBOR 3-Month</div>
            <div class="sig-value">…</div>
            <div class="stat-sub">Loading…</div>
            <div class="sig-date"></div>
        </div>
        <div class="sig-card" id="ire-sentiment">
            <div class="stat-label">Ireland Consumer Sentiment</div>
            <div class="sig-value">…</div>
            <div class="stat-sub">Loading…</div>
            <div class="sig-date"></div>
        </div>
    </div>

    <div class="algo-card">
        <h2>Suggested Market Rent</h2>
        <p>Calculated from live ECB rates, HICP inflation and EU sentiment — updated on each page load.</p>
        <div class="algo-result" id="suggested-rent">Calculating…</div>
        <div id="rent-algo-breakdown"></div>
    </div>

    <div class="content-card chart-card" style="margin-top:18px;">
        <h2>Monthly Revenue — Last 12 Months</h2>
        <p>Rent collected each month against the current expected monthly income. <span style="color:#16a34a;font-weight:600;">Green</span> bars met or exceeded target; <span style="color:#2563eb;font-weight:600;">blue</span> bars were below; <span style="color:#94a3b8;font-weight:600;">grey</span> months have no payments recorded yet.</p>
        <canvas id="revenue-chart"></canvas>
    </div>

    <div class="two-col-grid" style="margin-top:18px;">
        <div class="content-card chart-card" style="grid-column: 1 / -1;">
            <h2>Rent Comparison — Europe vs Our Portfolio</h2>
            <p>Live data from the <strong>Eurostat Statistics API</strong> (dataset: prc_colc_rents, 2023) compared to our portfolio average of €@portfolioAvg/month.</p>
            <div class="toolbar">
                <label for="building-filter" style="font-size:0.82rem;font-weight:600;color:var(--grey);text-transform:uppercase;letter-spacing:0.05em;">Dwelling type</label>
                <select id="building-filter" class="filter-select" disabled>
                    <option>Loading…</option>
                </select>
            </div>
            <div class="chart-status" style="color:var(--grey);font-size:0.88rem;margin-bottom:8px;"></div>
            <canvas id="rent-chart"></canvas>
        </div>
    </div>
    <div class="content-card map-card" style="margin-top:18px;">
        <h2>Property Locations</h2>
        <div id="property-map" style="height:320px;"></div>
    </div>

</div>

@if (selectedPin is not null)
{
    <div class="modal-overlay" @onclick="CloseModal"></div>
    <div class="modal-sheet" @onclick="CloseModal">
        <div class="modal-box" style="max-width:480px;" @onclick:stopPropagation>
            @if (!string.IsNullOrEmpty(selectedPin.ImagePath))
            {
                <img src="@selectedPin.ImagePath" style="width:100%;height:180px;object-fit:cover;border-radius:12px 12px 0 0;" alt="@selectedPin.Name" />
            }
            <div class="modal-blue-hdr">
                <div>
                    <h3>@selectedPin.Name</h3>
                    <p>@selectedPin.Address, @selectedPin.City @selectedPin.ZipCode</p>
                </div>
                <button class="modal-blue-close" @onclick="CloseModal">✕</button>
            </div>
            <div class="modal-body-inner">
                <div class="modal-detail-row">
                    <span>Status</span>
                    <span><span class="status-badge active">Active</span></span>
                </div>
                <div class="modal-detail-row">
                    <span>Total Units</span>
                    <span>@selectedPin.UnitCount</span>
                </div>
                <div class="modal-detail-row">
                    <span>Occupied Units</span>
                    <span>@selectedPin.OccupiedUnits</span>
                </div>
                <div class="modal-detail-row">
                    <span>Vacancy</span>
                    <span>@(selectedPin.UnitCount - selectedPin.OccupiedUnits) units available</span>
                </div>
                <div class="modal-detail-row">
                    <span>Contact Phone</span>
                    <span>@selectedPin.ContactPhone</span>
                </div>
                <div class="modal-detail-row">
                    <span>Contact Email</span>
                    <span>@selectedPin.ContactEmail</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Base stats
    int totalProperties, totalUnits, occupiedUnits, activeLeases;
    decimal portfolioAvg;

    // Role-specific stats
    string userRole = string.Empty;
    decimal monthlyRevenue;
    decimal totalOutstanding;
    int overdueCount, expiringSoon, pendingSignatures, paymentsThisMonth;

    // Revenue chart data
    string[] revenueLabels  = [];
    decimal[] revenueAmounts = [];

    int OccupancyPct => totalUnits > 0 ? (int)Math.Round(occupiedUnits * 100.0 / totalUnits) : 0;

    bool IsAdmin      => userRole == "Administrator";
    bool IsManager    => userRole == "PropertyManager";
    bool IsAccounting => userRole == "AccountingTeam";

    List<PropertyMapPin> pins = new();
    PropertyMapPin? selectedPin;
    DotNetObjectReference<Home>? dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        var auth    = await AuthStateProvider.GetAuthenticationStateAsync();
        var allowed = await AccessService.GetAllowedIdsAsync(auth.User);
        userRole    = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;

        // Base counts (all roles)
        totalProperties = await Db.Properties.CountAsync(p => p.IsActive && (allowed == null || allowed.Contains(p.Id)));
        totalUnits      = await Db.Units.CountAsync(u => u.IsActive && (allowed == null || allowed.Contains(u.PropertyId)));
        occupiedUnits   = await Db.Units.CountAsync(u => u.IsActive && u.IsOccupied && (allowed == null || allowed.Contains(u.PropertyId)));
        activeLeases    = await Db.Leases.CountAsync(l => l.Status == LeaseStatus.Active && (allowed == null || allowed.Contains(l.Unit.PropertyId)));

        var rentQuery = Db.Units.Where(u => u.IsActive && (allowed == null || allowed.Contains(u.PropertyId)));
        portfolioAvg  = await rentQuery.AnyAsync()
            ? Math.Round(await rentQuery.AverageAsync(u => u.MonthlyRent), 0)
            : 0;

        // Role-specific queries
        if (IsAdmin || IsAccounting)
        {
            monthlyRevenue = await Db.Units
                .Where(u => u.IsActive && u.IsOccupied && (allowed == null || allowed.Contains(u.PropertyId)))
                .SumAsync(u => (decimal?)u.MonthlyRent) ?? 0;

            // Outstanding balance: (months active × rent) − total paid, summed across all active leases
            var today      = DateTime.Today;
            var leaseStats = await Db.Leases
                .Where(l => l.Status == LeaseStatus.Active && (allowed == null || allowed.Contains(l.Unit.PropertyId)))
                .Select(l => new { l.StartDate, l.MonthlyRent, TotalPaid = l.RentPayments.Sum(p => (decimal?)p.Amount) ?? 0 })
                .ToListAsync();

            foreach (var l in leaseStats)
            {
                var months   = (int)Math.Max(1, Math.Floor((today - l.StartDate).TotalDays / 30.44));
                var balance  = Math.Max(0, months * l.MonthlyRent - l.TotalPaid);
                totalOutstanding += balance;
                if (balance > 0) overdueCount++;
            }

            if (IsAccounting)
            {
                var monthStart    = new DateTime(today.Year, today.Month, 1);
                paymentsThisMonth = await Db.RentPayments
                    .CountAsync(p => p.PaymentDate >= monthStart && (allowed == null || allowed.Contains(p.Lease.Unit.PropertyId)));
            }
        }

        if (IsAdmin || IsManager)
        {
            expiringSoon      = await Db.Leases.CountAsync(l =>
                l.Status == LeaseStatus.Active &&
                l.EndDate  <= DateTime.Today.AddDays(60) &&
                (allowed == null || allowed.Contains(l.Unit.PropertyId)));

            pendingSignatures = await Db.Leases.CountAsync(l =>
                l.Status          == LeaseStatus.Active &&
                l.SignatureStatus  == SignatureStatus.Pending &&
                (allowed == null || allowed.Contains(l.Unit.PropertyId)));
        }

        // Revenue trend — last 12 months
        var chartStart   = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-11);
        var rawPayments  = await Db.RentPayments
            .Where(p => p.PaymentDate >= chartStart && (allowed == null || allowed.Contains(p.Lease.Unit.PropertyId)))
            .Select(p => new { p.PaymentDate, p.Amount })
            .ToListAsync();

        var labels  = new List<string>();
        var amounts = new List<decimal>();
        for (int i = 11; i >= 0; i--)
        {
            var m     = DateTime.Today.AddMonths(-i);
            var start = new DateTime(m.Year, m.Month, 1);
            var end   = start.AddMonths(1);
            labels.Add(m.ToString("MMM yy"));
            amounts.Add(rawPayments.Where(p => p.PaymentDate >= start && p.PaymentDate < end).Sum(p => p.Amount));
        }
        revenueLabels  = [.. labels];
        revenueAmounts = [.. amounts];

        pins = await Db.Properties
            .Where(p => p.IsActive && p.Latitude != 0 && (allowed == null || allowed.Contains(p.Id)))
            .Select(p => new PropertyMapPin
            {
                Name          = p.Name,
                Address       = p.Address,
                City          = p.City,
                ZipCode       = p.ZipCode,
                ContactPhone  = p.ContactPhone,
                ContactEmail  = p.ContactEmail,
                ImagePath     = p.ImagePath,
                Latitude      = p.Latitude,
                Longitude     = p.Longitude,
                UnitCount     = p.Units.Count(u => u.IsActive),
                OccupiedUnits = p.Units.Count(u => u.IsActive && u.IsOccupied)
            })
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("economicSignals.init"); } catch { }
            try { await JS.InvokeVoidAsync("revenueChart.init", "revenue-chart", revenueLabels, revenueAmounts, monthlyRevenue); } catch { }
            try { await JS.InvokeVoidAsync("rentChart.init", "rent-chart", portfolioAvg); } catch { }
            try
            {
                dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("leafletMap.init", "property-map", pins, dotNetRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public void ShowProperty(string name)
    {
        selectedPin = pins.FirstOrDefault(p => p.Name == name);
        StateHasChanged();
    }

    void CloseModal() => selectedPin = null;

    public void Dispose() => dotNetRef?.Dispose();

    record PropertyMapPin
    {
        public string  Name          { get; init; } = string.Empty;
        public string  Address       { get; init; } = string.Empty;
        public string  City          { get; init; } = string.Empty;
        public string  ZipCode       { get; init; } = string.Empty;
        public string  ContactPhone  { get; init; } = string.Empty;
        public string  ContactEmail  { get; init; } = string.Empty;
        public string? ImagePath     { get; init; }
        public double  Latitude      { get; init; }
        public double  Longitude     { get; init; }
        public int     UnitCount     { get; init; }
        public int     OccupiedUnits { get; init; }
    }
}
