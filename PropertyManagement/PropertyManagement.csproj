<!-- this is the project file, it defines the framework version, settings, and all the packages/libraries the app uses -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>                                      <!-- using .NET 10 -->
    <Nullable>enable</Nullable>                                                     <!-- forces me to handle nulls properly, helps avoid null reference crashes -->
    <ImplicitUsings>enable</ImplicitUsings>                                         <!-- auto imports common namespaces so i dont have to write them manually -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException> <!-- stops blazor from throwing an error when navigating away mid-render -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />                           <!-- for sending emails through azure -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.28.0" />                               <!-- for storing files like signed lease pdfs in azure blob storage -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />                                         <!-- for generating excel files in reports -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.3" />         <!-- google login support -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.7" /> <!-- microsoft login support -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.3" />  <!-- connects asp.net identity (users/roles/login) to the database -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">                 <!-- needed to run migrations from the command line -->
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.3" />               <!-- sqlite database provider, used for local development -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.3" />            <!-- sql server provider, used for production -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.3">                  <!-- gives me dotnet ef commands like add-migration and update-database -->
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
