@page "/tenants"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator,PropertyManager")]
@inject ITenantService TenantService
@inject ILeaseService LeaseService
@inject IRentPaymentService PaymentService
@inject IPropertyAccessService AccessService
@inject AuthenticationStateProvider AuthStateProvider
@using PropertyManagement.Services

<PageTitle>Tenants - PropertyMS</PageTitle>

<div class="page-wrap">

    <!-- Page Header -->
    <div class="page-hdr">
        <div>
            <h1>Tenants</h1>
            <p>@tenants.Count @(tenants.Count == 1 ? "tenant" : "tenants") &nbsp;·&nbsp; @tenants.Count(t => t.IsActive) active</p>
        </div>
        <button class="btn-primary-action" @onclick="() => OpenForm()">
            <svg width="14" height="14" fill="none" viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Add Tenant
        </button>
    </div>

    <!-- Stats -->
    <div class="stats-grid g4">
        <div class="stat-card">
            <div class="stat-label">Total Tenants</div>
            <div class="stat-value">@tenants.Count</div>
            <div class="stat-sub">All records</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Active</div>
            <div class="stat-value">@tenants.Count(t => t.IsActive)</div>
            <div class="stat-sub">Current tenants</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Inactive</div>
            <div class="stat-value">@tenants.Count(t => !t.IsActive)</div>
            <div class="stat-sub">Former tenants</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">At Risk</div>
            <div class="stat-value" style="color:var(--red)">@healthScores.Values.Count(s => s.Level == "Red")</div>
            <div class="stat-sub">@healthScores.Values.Count(s => s.Level == "Amber") expiring / no lease</div>
        </div>
    </div>

    <!-- Alert -->
    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div class="alert-banner success">
            <span>@successMsg</span>
            <button class="btn-action sm" @onclick="() => successMsg = string.Empty">✕</button>
        </div>
    }

    <!-- Table Card -->
    <div class="content-card panel">
        @if (loading)
        {
            <div style="display:flex;justify-content:center;padding:32px;">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (!tenants.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">👤</div>
                <h3>No tenants yet</h3>
                <p>Add your first tenant to get started.</p>
            </div>
        }
        else
        {
            <div class="toolbar">
                <div class="search-wrap">
                    <svg width="15" height="15" fill="none" viewBox="0 0 15 15">
                        <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M10.5 10.5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    <input class="search-inp" placeholder="Search by name or email…"
                           value="@searchTerm" @oninput="e => searchTerm = e.Value?.ToString() ?? string.Empty" />
                </div>
                <select class="filter-select" @bind="statusFilter">
                    <option value="">All Statuses</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
                <select class="filter-select" @bind="healthFilter">
                    <option value="">All Health</option>
                    <option value="Green">✅ Good</option>
                    <option value="Amber">⚠️ Attention</option>
                    <option value="Red">🔴 At Risk</option>
                </select>
            </div>

            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tenant</th>
                            <th>Phone</th>
                            <th>Employer</th>
                            <th>Status</th>
                            <th>Health</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in FilteredTenants)
                        {
                            <tr style="cursor:pointer;" @onclick="() => OpenPanel(t)" @onclick:stopPropagation="false">
                                <td>
                                    <div class="user-cell">
                                        <div class="user-initials">@t.FirstName[0]@t.LastName[0]</div>
                                        <div class="user-meta">
                                            <strong>@t.FullName</strong>
                                            <span>@t.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td style="color:var(--grey);font-size:0.9rem;">@(string.IsNullOrEmpty(t.Phone) ? "—" : t.Phone)</td>
                                <td style="color:var(--grey);font-size:0.9rem;">@(string.IsNullOrEmpty(t.EmployerName) ? "—" : t.EmployerName)</td>
                                <td>
                                    <span class="status-badge @(t.IsActive ? "active" : "inactive")">
                                        @(t.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var hs = healthScores.GetValueOrDefault(t.Id);
                                    }
                                    @if (hs != null)
                                    {
                                        <span title="@hs.Reason" style="display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:999px;font-size:0.75rem;font-weight:700;cursor:default;
                                            background:@(hs.Level == "Red" ? "#fee2e2" : hs.Level == "Amber" ? "#fef9c3" : "#dcfce7");
                                            color:@(hs.Level == "Red" ? "#dc2626" : hs.Level == "Amber" ? "#b45309" : "#16a34a");">
                                            @(hs.Level == "Red" ? "🔴" : hs.Level == "Amber" ? "⚠️" : "✅")
                                            @hs.Label
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8;font-size:0.8rem;">—</span>
                                    }
                                </td>
                                <td @onclick:stopPropagation="true">
                                    <div class="action-btns">
                                        <button class="btn-action sm" @onclick="() => OpenForm(t)">Edit</button>
                                        @if (t.IsActive)
                                        {
                                            <button class="btn-action sm danger" @onclick="() => Deactivate(t.Id)">Deactivate</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

<!-- Tenant Modal -->
@if (showForm)
{
    <div class="modal-overlay" @onclick="() => showForm = false"></div>
    <div class="modal-sheet" @onclick="() => showForm = false">
        <div class="modal-box" style="max-width:640px;" @onclick:stopPropagation="true">
            <div class="modal-top">
                <h2>@(editing.Id == 0 ? "Add Tenant" : "Edit Tenant")</h2>
                <button class="modal-close" @onclick="() => showForm = false">✕</button>
            </div>
            <div class="modal-body-inner">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="field-error">@formError</div>
                }
                <div style="display:flex;flex-direction:column;gap:14px;">
                    <div class="field-row c2">
                        <div class="field-group">
                            <label class="field-label">First Name *</label>
                            <input class="field-input" @bind="editing.FirstName" placeholder="Jane" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Last Name *</label>
                            <input class="field-input" @bind="editing.LastName" placeholder="Smith" />
                        </div>
                    </div>
                    <div class="field-row c2">
                        <div class="field-group">
                            <label class="field-label">Email *</label>
                            <input class="field-input" type="email" @bind="editing.Email" placeholder="jane@example.com" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Phone</label>
                            <input class="field-input" @bind="editing.Phone" placeholder="+353 87 123 4567" />
                        </div>
                    </div>
                    <div class="field-row c2">
                        <div class="field-group">
                            <label class="field-label">Date of Birth</label>
                            <input class="field-input" type="date" @bind="editing.DateOfBirth" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Employer Name</label>
                            <input class="field-input" @bind="editing.EmployerName" placeholder="Acme Ltd." />
                        </div>
                    </div>
                    <div class="field-row c2">
                        <div class="field-group">
                            <label class="field-label">Employer Phone</label>
                            <input class="field-input" @bind="editing.EmployerPhone" placeholder="+353 1 234 5678" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Emergency Contact Name</label>
                            <input class="field-input" @bind="editing.EmergencyContactName" placeholder="John Smith" />
                        </div>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Emergency Contact Phone</label>
                        <input class="field-input" @bind="editing.EmergencyContactPhone" placeholder="+353 87 999 8888" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Notes</label>
                        <textarea class="field-input" rows="2" @bind="editing.Notes" placeholder="Any additional notes…" style="resize:vertical;"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn-cancel" @onclick="() => showForm = false">Cancel</button>
                <button class="btn-save" @onclick="Save">@(editing.Id == 0 ? "Add Tenant" : "Save Changes")</button>
            </div>
        </div>
    </div>
}

@if (selectedTenant != null)
{
    <!-- Overlay -->
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.35);z-index:1040;" @onclick="ClosePanel"></div>

    <!-- Slide-in panel -->
    <div style="position:fixed;top:0;right:0;bottom:0;width:420px;background:#fff;box-shadow:-6px 0 32px rgba(0,0,0,0.14);z-index:1041;overflow-y:auto;display:flex;flex-direction:column;">

        <!-- Header -->
        <div style="padding:22px 24px 18px;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;gap:14px;">
            <div class="user-initials" style="width:50px;height:50px;font-size:1.1rem;flex-shrink:0;">
                @selectedTenant.FirstName[0]@selectedTenant.LastName[0]
            </div>
            <div style="flex:1;min-width:0;">
                <div style="font-weight:700;font-size:1.05rem;color:#1c1c1e;">@selectedTenant.FullName</div>
                <div style="font-size:0.82rem;color:#6b7280;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@selectedTenant.Email</div>
                @if (!string.IsNullOrEmpty(selectedTenant.Phone))
                {
                    <div style="font-size:0.8rem;color:#94a3b8;">@selectedTenant.Phone</div>
                }
            </div>
            <button @onclick="ClosePanel" style="background:none;border:none;font-size:1.1rem;color:#94a3b8;cursor:pointer;padding:4px 8px;line-height:1;">✕</button>
        </div>

        @if (panelLoading)
        {
            <div style="display:flex;justify-content:center;padding:40px;">
                <div class="spinner"></div>
            </div>
        }
        else
        {
            <!-- Health badge -->
            var hs = healthScores.GetValueOrDefault(selectedTenant.Id);
            if (hs != null)
            {
                <div style="padding:14px 24px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;gap:10px;">
                    <span style="padding:4px 12px;border-radius:999px;font-size:0.78rem;font-weight:700;
                        background:@(hs.Level=="Red"?"#fee2e2":hs.Level=="Amber"?"#fef9c3":"#dcfce7");
                        color:@(hs.Level=="Red"?"#dc2626":hs.Level=="Amber"?"#b45309":"#16a34a");">
                        @(hs.Level=="Red"?"🔴":hs.Level=="Amber"?"⚠️":"✅") @hs.Label
                    </span>
                    <span style="font-size:0.78rem;color:#94a3b8;">@hs.Reason</span>
                </div>
            }

            <!-- Active Lease -->
            @if (panelLease != null)
            {
                <div style="padding:18px 24px;border-bottom:1px solid #f1f5f9;">
                    <div style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#94a3b8;margin-bottom:10px;">Current Lease</div>
                    <div style="font-weight:700;font-size:0.95rem;color:#1c1c1e;">@panelLease.Unit.Property.Name</div>
                    <div style="font-size:0.85rem;color:#6b7280;margin-bottom:10px;">Unit @panelLease.Unit.UnitNumber · @panelLease.Unit.Type</div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                        <div style="background:#f8fafc;border-radius:8px;padding:10px 12px;">
                            <div style="font-size:0.7rem;color:#94a3b8;font-weight:600;text-transform:uppercase;">Monthly Rent</div>
                            <div style="font-weight:700;color:#1c1c1e;font-size:0.95rem;">€@panelLease.MonthlyRent.ToString("N0")</div>
                        </div>
                        <div style="background:#f8fafc;border-radius:8px;padding:10px 12px;">
                            <div style="font-size:0.7rem;color:#94a3b8;font-weight:600;text-transform:uppercase;">Outstanding</div>
                            <div style="font-weight:700;font-size:0.95rem;color:@(panelBalance > 0 ? "#dc2626" : "#16a34a");">
                                @(panelBalance > 0 ? $"€{panelBalance:N0}" : "Paid up")
                            </div>
                        </div>
                        <div style="background:#f8fafc;border-radius:8px;padding:10px 12px;">
                            <div style="font-size:0.7rem;color:#94a3b8;font-weight:600;text-transform:uppercase;">Lease Start</div>
                            <div style="font-weight:600;color:#374151;font-size:0.85rem;">@panelLease.StartDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <div style="background:#f8fafc;border-radius:8px;padding:10px 12px;">
                            <div style="font-size:0.7rem;color:#94a3b8;font-weight:600;text-transform:uppercase;">Lease End</div>
                            <div style="font-weight:600;font-size:0.85rem;color:@((panelLease.EndDate - DateTime.Today).Days <= 60 ? "#b45309" : "#374151");">
                                @panelLease.EndDate.ToString("dd MMM yyyy")
                                @if ((panelLease.EndDate - DateTime.Today).Days is >= 0 and <= 60)
                                {
                                    <span style="font-size:0.72rem;"> (@((panelLease.EndDate-DateTime.Today).Days)d)</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div style="padding:16px 24px;border-bottom:1px solid #f1f5f9;">
                    <div style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#94a3b8;margin-bottom:6px;">Current Lease</div>
                    <div style="color:#94a3b8;font-size:0.85rem;">No active lease</div>
                </div>
            }

            <!-- Recent Payments -->
            <div style="padding:18px 24px;border-bottom:1px solid #f1f5f9;">
                <div style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#94a3b8;margin-bottom:10px;">Recent Payments</div>
                @if (!panelPayments.Any())
                {
                    <div style="color:#94a3b8;font-size:0.85rem;">No payments recorded</div>
                }
                else
                {
                    @foreach (var p in panelPayments)
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:7px 0;border-bottom:1px solid #f8fafc;">
                            <div>
                                <div style="font-size:0.84rem;font-weight:600;color:#374151;">€@p.Amount.ToString("N2")</div>
                                <div style="font-size:0.74rem;color:#94a3b8;">@p.PaymentDate.ToString("dd MMM yyyy") · @p.PaymentMethod</div>
                            </div>
                            @if (p.OutstandingBalance > 0)
                            {
                                <span style="font-size:0.72rem;background:#fee2e2;color:#dc2626;padding:2px 8px;border-radius:999px;font-weight:700;">€@p.OutstandingBalance.ToString("N0") left</span>
                            }
                            else
                            {
                                <span style="font-size:0.72rem;background:#dcfce7;color:#16a34a;padding:2px 8px;border-radius:999px;font-weight:700;">Paid</span>
                            }
                        </div>
                    }
                }
            </div>

            <!-- Contact details -->
            <div style="padding:18px 24px;">
                <div style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#94a3b8;margin-bottom:10px;">Contact Details</div>
                @if (selectedTenant.DateOfBirth.HasValue)
                {
                    <div style="display:flex;justify-content:space-between;padding:5px 0;font-size:0.84rem;">
                        <span style="color:#94a3b8;">Date of Birth</span>
                        <span style="color:#374151;font-weight:600;">@selectedTenant.DateOfBirth.Value.ToString("dd MMM yyyy")</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedTenant.EmployerName))
                {
                    <div style="display:flex;justify-content:space-between;padding:5px 0;font-size:0.84rem;">
                        <span style="color:#94a3b8;">Employer</span>
                        <span style="color:#374151;font-weight:600;">@selectedTenant.EmployerName</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedTenant.EmployerPhone))
                {
                    <div style="display:flex;justify-content:space-between;padding:5px 0;font-size:0.84rem;">
                        <span style="color:#94a3b8;">Employer Phone</span>
                        <span style="color:#374151;font-weight:600;">@selectedTenant.EmployerPhone</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedTenant.EmergencyContactName))
                {
                    <div style="display:flex;justify-content:space-between;padding:5px 0;font-size:0.84rem;">
                        <span style="color:#94a3b8;">Emergency Contact</span>
                        <span style="color:#374151;font-weight:600;">@selectedTenant.EmergencyContactName</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedTenant.EmergencyContactPhone))
                {
                    <div style="display:flex;justify-content:space-between;padding:5px 0;font-size:0.84rem;">
                        <span style="color:#94a3b8;">Emergency Phone</span>
                        <span style="color:#374151;font-weight:600;">@selectedTenant.EmergencyContactPhone</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedTenant.Notes))
                {
                    <div style="margin-top:10px;padding:10px 12px;background:#f8fafc;border-radius:8px;font-size:0.82rem;color:#6b7280;">
                        @selectedTenant.Notes
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    bool loading = true, showForm, panelLoading;
    List<Tenant> tenants = new();
    Dictionary<int, TenantHealthScore> healthScores = new();
    Tenant editing = new();
    string successMsg = string.Empty, formError = string.Empty;
    string searchTerm = string.Empty, statusFilter = string.Empty, healthFilter = string.Empty;
    HashSet<int>? allowedIds;

    // Profile panel
    Tenant? selectedTenant;
    Lease?  panelLease;
    decimal panelBalance;
    List<RentPayment> panelPayments = new();

    IEnumerable<Tenant> FilteredTenants => tenants.Where(t =>
        (string.IsNullOrWhiteSpace(searchTerm) || t.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || t.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(statusFilter)    || (statusFilter == "active" ? t.IsActive : !t.IsActive)) &&
        (string.IsNullOrEmpty(healthFilter)    || healthScores.GetValueOrDefault(t.Id)?.Level == healthFilter)
    );

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        allowedIds = await AccessService.GetAllowedIdsAsync(auth.User);
        tenants = await LoadTenants();
        healthScores = await TenantService.GetHealthScoresAsync(tenants.Select(t => t.Id));
        loading = false;
    }

    async Task<List<Tenant>> LoadTenants() =>
        allowedIds == null
            ? await TenantService.GetAllAsync()
            : await TenantService.GetByPropertyIdsAsync(allowedIds);

    async Task OpenPanel(Tenant t)
    {
        selectedTenant = t;
        panelLoading   = true;
        panelLease     = null;
        panelBalance   = 0;
        panelPayments  = new();

        var leases = await LeaseService.GetByTenantIdAsync(t.Id);
        panelLease = leases.FirstOrDefault(l => l.Status == LeaseStatus.Active)
                  ?? leases.FirstOrDefault();

        if (panelLease != null)
        {
            panelBalance  = await LeaseService.GetOutstandingBalanceAsync(panelLease.Id);
            panelPayments = await PaymentService.GetRecentByLeaseIdAsync(panelLease.Id);
        }

        panelLoading = false;
    }

    void ClosePanel() => selectedTenant = null;

    void OpenForm(Tenant? t = null)
    {
        editing = t != null
            ? new Tenant { Id = t.Id, FirstName = t.FirstName, LastName = t.LastName, Email = t.Email, Phone = t.Phone, DateOfBirth = t.DateOfBirth, EmployerName = t.EmployerName, EmployerPhone = t.EmployerPhone, EmergencyContactName = t.EmergencyContactName, EmergencyContactPhone = t.EmergencyContactPhone, Notes = t.Notes, IsActive = t.IsActive }
            : new Tenant();
        formError = string.Empty;
        showForm = true;
    }

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(editing.FirstName) || string.IsNullOrWhiteSpace(editing.LastName) || string.IsNullOrWhiteSpace(editing.Email))
        {
            formError = "First name, last name, and email are required.";
            return;
        }
        if (editing.Id == 0)
            await TenantService.CreateAsync(editing);
        else
            await TenantService.UpdateAsync(editing);

        showForm = false;
        successMsg = editing.Id == 0 ? "Tenant added." : "Tenant updated.";
        tenants = await LoadTenants();
        healthScores = await TenantService.GetHealthScoresAsync(tenants.Select(t => t.Id));
    }

    async Task Deactivate(int id)
    {
        await TenantService.DeactivateAsync(id);
        successMsg = "Tenant deactivated.";
        tenants = await LoadTenants();
        healthScores = await TenantService.GetHealthScoresAsync(tenants.Select(t => t.Id));
    }
}
