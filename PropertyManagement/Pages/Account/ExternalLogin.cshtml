@page
@model PropertyManagement.Pages.Account.ExternalLoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Signing in — KeyPort</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="card p-4 shadow" style="max-width:420px;width:100%">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">&#9888;&nbsp; @Model.ErrorMessage</div>
            <a href="/Account/Login" class="btn btn-secondary w-100">Back to Login</a>
        }
        else
        {
            <p class="text-center text-muted">Completing sign-in, please wait...</p>
        }
    </div>
</body>
</html>
