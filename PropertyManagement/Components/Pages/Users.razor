@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@inject IUserService UserService
@inject IAuditLogService AuditService
@inject IPropertyService PropertyService
@inject AuthenticationStateProvider AuthStateProvider
@using PropertyManagement.Models

<PageTitle>User Management - PropertyMS</PageTitle>

<div class="page-wrap">

    <div class="page-hdr">
        <div>
            <h1>User Management</h1>
            <p>Manage user accounts, roles, and account status from one clean admin view.</p>
        </div>
        <button class="btn-primary-action" @onclick="OpenCreateForm">+ Add User</button>
    </div>

    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div class="alert-banner success">
            <span>@successMsg</span>
            <button class="btn-action sm" @onclick="() => successMsg = string.Empty">✕</button>
        </div>
    }

    <section class="stats-grid g4">
        <div class="stat-card">
            <div class="stat-label">Total Users</div>
            <div class="stat-value">@users.Count</div>
            <div class="stat-sub">Across all account types</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Active Users</div>
            <div class="stat-value">@users.Count(u => u.IsActive)</div>
            <div class="stat-sub">Currently enabled accounts</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Administrators</div>
            <div class="stat-value">@users.Count(u => u.Role == UserRole.Administrator)</div>
            <div class="stat-sub">Users with elevated access</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Events Today</div>
            <div class="stat-value">@eventsToday</div>
            <div class="stat-sub">Admin actions logged</div>
        </div>
    </section>

    <section class="content-card panel">
        <div class="toolbar">
            <div class="search-wrap">
                <svg width="15" height="15" fill="none" viewBox="0 0 15 15" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--grey);pointer-events:none;">
                    <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M10.5 10.5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <input class="search-inp" type="text" placeholder="Search by name or email..." @bind="searchText" @bind:event="oninput" @bind:after="OnUserFilterChanged" />
            </div>
            <select class="filter-select" @bind="roleFilter" @bind:after="OnUserFilterChanged">
                <option value="">All Roles</option>
                @foreach (var r in Enum.GetValues<UserRole>())
                {
                    <option value="@r">@r</option>
                }
            </select>
            <select class="filter-select" @bind="statusFilter" @bind:after="OnUserFilterChanged">
                <option value="">All Statuses</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>

        <div class="table-scroll">
            @if (loading)
            {
                <div style="display:flex;justify-content:center;padding:32px;">
                    <div class="spinner-border text-primary"></div>
                </div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Property Access</th>
                            <th>Status</th>
                            <th>Last Login</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in PagedUsers)
                        {
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-initials">@Initials(u)</div>
                                        <div class="user-meta">
                                            <strong>@u.FullName</strong>
                                            <span>@u.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td><span style="font-weight:600;font-size:0.9rem;color:#374151">@u.Role</span></td>
                                <td>
                                    @if (u.Role == UserRole.Administrator)
                                    {
                                        <span style="font-size:0.78rem;color:#16a34a;font-weight:600;">Full access</span>
                                    }
                                    else
                                    {
                                        var count = assignmentCounts.GetValueOrDefault(u.Id, 0);
                                        if (count == 0)
                                        {
                                            <span style="font-size:0.78rem;color:#94a3b8;">All properties</span>
                                        }
                                        else
                                        {
                                            <span style="font-size:0.78rem;color:#2563eb;font-weight:600;">@count of @totalPropertyCount</span>
                                        }
                                    }
                                </td>
                                <td>
                                    <span class="status-badge @(u.IsActive ? "active" : "inactive")">
                                        @(u.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td style="color:var(--grey);font-size:0.9rem;">@(u.LastLogin?.ToString("dd MMM yyyy, HH:mm") ?? "Never")</td>
                                <td>
                                    <div class="action-btns">
                                        <button class="btn-action sm" @onclick="() => OpenEditForm(u)">Edit</button>
                                        @if (u.IsActive)
                                        {
                                            <button class="btn-action sm danger" @onclick="() => ConfirmDisable(u)">Disable</button>
                                        }
                                        else
                                        {
                                            <button class="btn-action sm primary" @onclick="() => Activate(u)">Activate</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (!loading && UserTotalPages > 1)
        {
            <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 20px;border-top:1px solid var(--border);">
                <span style="font-size:0.8rem;color:var(--grey);">
                    Page @userPage of @UserTotalPages &nbsp;·&nbsp; @FilteredUsers.Count() users
                </span>
                <div style="display:flex;gap:6px;">
                    <button class="btn-action sm" disabled="@(userPage <= 1)" @onclick="() => userPage--">← Prev</button>
                    <button class="btn-action sm" disabled="@(userPage >= UserTotalPages)" @onclick="() => userPage++">Next →</button>
                </div>
            </div>
        }
    </section>

    <!-- Activity Feed -->
    <section class="content-card panel" style="margin-top:20px;">
        <div style="padding:16px 20px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none;"
             @onclick="() => showFeed = !showFeed">
            <div style="display:flex;align-items:center;gap:10px;">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#64748b;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                <span style="font-weight:700;font-size:0.95rem;color:#1c1c1e;">Activity Log</span>
                @if (auditLogs.Any())
                {
                    <span style="background:#2563eb;color:#fff;border-radius:999px;padding:1px 9px;font-size:0.72rem;font-weight:700;">@auditLogs.Count</span>
                }
            </div>
            <span style="color:var(--grey);font-size:0.78rem;font-weight:500;">
                @(showFeed ? "▲ Hide" : "▼ Show")
            </span>
        </div>

        @if (showFeed)
        {
            <div style="border-top:1px solid var(--border);">
                @if (auditLogs.Any())
                {
                    <!-- Log filter bar -->
                    <div style="display:flex;gap:10px;padding:12px 20px;border-bottom:1px solid var(--border);flex-wrap:wrap;">
                        <input type="text" placeholder="Search by name or email…"
                               style="padding:6px 12px;border:1px solid #d1d5db;border-radius:7px;font-size:0.82rem;flex:1;min-width:160px;"
                               @bind="logSearch" @bind:event="oninput" @bind:after="OnLogFilterChanged" />
                        <select style="padding:6px 10px;border:1px solid #d1d5db;border-radius:7px;font-size:0.82rem;"
                                @bind="logActionFilter" @bind:after="OnLogFilterChanged">
                            <option value="">All Actions</option>
                            <option value="User Created">User Created</option>
                            <option value="User Updated">User Updated</option>
                            <option value="User Activated">User Activated</option>
                            <option value="User Deactivated">User Deactivated</option>
                            <option value="Access Changed">Access Changed</option>
                        </select>
                    </div>
                }

                @if (!FilteredLogs.Any())
                {
                    <div class="empty-state" style="padding:32px 20px;">
                        <div class="empty-icon">📋</div>
                        <h3>@(auditLogs.Any() ? "No matching events" : "No activity yet")</h3>
                        <p>@(auditLogs.Any() ? "Try adjusting the filters." : "Actions will appear here as users are created, modified, or disabled.")</p>
                    </div>
                }
                else
                {
                    <div style="padding:4px 0;">
                        @foreach (var log in PagedLogs)
                        {
                            <div style="display:flex;align-items:flex-start;gap:14px;padding:13px 20px;border-bottom:1px solid #f8fafc;transition:background 0.15s;"
                                 onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background=''">
                                <div style="width:36px;height:36px;border-radius:50%;background:@ActionBg(log.Action);display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;margin-top:1px;box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                                    @ActionIcon(log.Action)
                                </div>
                                <div style="flex:1;min-width:0;">
                                    <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;">
                                        <span style="font-weight:700;font-size:0.84rem;color:@ActionTextColor(log.Action);">@log.Action</span>
                                        <span style="font-size:0.84rem;color:#1c1c1e;font-weight:600;">@log.TargetName</span>
                                        <span style="font-size:0.76rem;color:#94a3b8;">@log.TargetEmail</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(log.Details))
                                    {
                                        <div style="font-size:0.78rem;color:#6b7280;margin-top:2px;">@log.Details</div>
                                    }
                                    <div style="font-size:0.73rem;color:#94a3b8;margin-top:4px;">
                                        By&nbsp;<strong style="color:#64748b;">@log.PerformedBy</strong>
                                        &nbsp;·&nbsp;
                                        <span title="@log.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC">@RelativeTime(log.CreatedAt)</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (LogTotalPages > 1)
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 20px;border-top:1px solid var(--border);">
                            <span style="font-size:0.8rem;color:var(--grey);">
                                Page @logPage of @LogTotalPages &nbsp;·&nbsp; @FilteredLogs.Count() events
                            </span>
                            <div style="display:flex;gap:6px;">
                                <button class="btn-action sm" disabled="@(logPage <= 1)" @onclick="() => logPage--">← Prev</button>
                                <button class="btn-action sm" disabled="@(logPage >= LogTotalPages)" @onclick="() => logPage++">Next →</button>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </section>

</div>

@if (showForm)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editing.Id == 0 ? "Create User" : "Edit User")</h5>
                    <button type="button" class="btn-close" @onclick="() => showForm = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="alert alert-danger">@formError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label fw-semibold">First Name *</label>
                        <input class="form-control" @bind="editing.FirstName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Last Name *</label>
                        <input class="form-control" @bind="editing.LastName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email *</label>
                        <input class="form-control" type="email" @bind="editing.Email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            @(editing.Id == 0 ? "Password *" : "New Password (leave blank to keep current)")
                        </label>
                        <input class="form-control" type="password" @bind="password" @bind:event="oninput" autocomplete="new-password" />
                        @if (!string.IsNullOrEmpty(password))
                        {
                            <div style="margin-top:8px;padding:10px 12px;background:#f8fafc;border-radius:8px;display:flex;flex-direction:column;gap:4px;">
                                @foreach (var req in PasswordRequirements)
                                {
                                    <div style="display:flex;align-items:center;gap:7px;font-size:0.78rem;color:@(req.Met ? "#16a34a" : "#dc2626");">
                                        <span style="font-size:0.72rem;">@(req.Met ? "✓" : "✗")</span>
                                        @req.Label
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Role *</label>
                        <select class="form-select" @bind="editing.Role">
                            @foreach (var r in Enum.GetValues<UserRole>())
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="editing.IsActive" id="userActive" />
                        <label class="form-check-label" for="userActive">Account Active</label>
                    </div>

                    @if (editing.Role != UserRole.Administrator)
                    {
                        <div class="mb-3" style="margin-top:1rem;">
                            <label class="form-label fw-semibold">
                                🏢 Property Access
                            </label>
                            <div style="background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:10px;padding:12px 14px;">
                                @foreach (var p in allProperties)
                                {
                                    <div style="display:flex;align-items:center;gap:10px;padding:5px 0;border-bottom:1px solid #f1f5f9;">
                                        <input type="checkbox" id="prop-@p.Id"
                                               checked="@assignedPropertyIds.Contains(p.Id)"
                                               @onchange="e => ToggleProperty(p.Id, (bool)e.Value!)"
                                               style="width:15px;height:15px;cursor:pointer;" />
                                        <label for="prop-@p.Id" style="font-size:0.85rem;cursor:pointer;margin:0;flex:1;">
                                            <strong>@p.Name</strong>
                                            <span style="color:#94a3b8;font-size:0.78rem;margin-left:6px;">@p.City</span>
                                        </label>
                                    </div>
                                }
                                <p style="font-size:0.72rem;color:#94a3b8;margin:8px 0 0;">
                                    Leave all unchecked to grant access to all properties.
                                </p>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="Save">Save User</button>
                </div>
            </div>
        </div>
    </div>
}

@if (pendingDisable != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block">
        <div class="modal-dialog modal-sm" style="margin-top:15vh;">
            <div class="modal-content">
                <div class="modal-header" style="border-bottom:none;padding-bottom:0;">
                    <h5 class="modal-title" style="color:#dc2626;">Disable Account</h5>
                    <button type="button" class="btn-close" @onclick="() => pendingDisable = null"></button>
                </div>
                <div class="modal-body" style="padding-top:10px;">
                    <p style="margin:0;color:#374151;">
                        Are you sure you want to disable <strong>@pendingDisable.FullName</strong>?
                        They will no longer be able to log in.
                    </p>
                </div>
                <div class="modal-footer" style="border-top:none;">
                    <button class="btn btn-secondary" @onclick="() => pendingDisable = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="Deactivate">Yes, Disable</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool loading = true, showForm, showFeed = true;
    List<User> users              = new();
    List<AuditLog> auditLogs      = new();
    List<Property> allProperties  = new();
    HashSet<int> assignedPropertyIds  = new();
    HashSet<int> originalPropertyIds  = new();
    Dictionary<int, int> assignmentCounts = new();
    int totalPropertyCount;
    User editing             = new();
    User? pendingDisable;
    string password          = string.Empty;
    string successMsg        = string.Empty, formError = string.Empty;
    string searchText        = string.Empty, roleFilter = string.Empty, statusFilter = string.Empty;
    string logSearch         = string.Empty, logActionFilter = string.Empty;
    string currentUserName   = string.Empty;
    UserRole originalRole;
    int eventsToday;

    // User table pagination
    int userPage = 1;
    const int UserPageSize = 10;

    // Audit log pagination
    int logPage = 1;
    const int LogPageSize = 15;

    IEnumerable<User> FilteredUsers => users.Where(u =>
        (string.IsNullOrEmpty(searchText) || u.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase) || u.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(roleFilter) || u.Role.ToString() == roleFilter) &&
        (string.IsNullOrEmpty(statusFilter) || (statusFilter == "active" ? u.IsActive : !u.IsActive))
    );

    IEnumerable<User> PagedUsers => FilteredUsers.Skip((userPage - 1) * UserPageSize).Take(UserPageSize);
    int UserTotalPages => Math.Max(1, (int)Math.Ceiling(FilteredUsers.Count() / (double)UserPageSize));

    IEnumerable<AuditLog> FilteredLogs => auditLogs.Where(a =>
        (string.IsNullOrEmpty(logActionFilter) || a.Action == logActionFilter) &&
        (string.IsNullOrEmpty(logSearch) || a.TargetName.Contains(logSearch, StringComparison.OrdinalIgnoreCase) || a.TargetEmail.Contains(logSearch, StringComparison.OrdinalIgnoreCase))
    );

    IEnumerable<AuditLog> PagedLogs => FilteredLogs.Skip((logPage - 1) * LogPageSize).Take(LogPageSize);
    int LogTotalPages => Math.Max(1, (int)Math.Ceiling(FilteredLogs.Count() / (double)LogPageSize));

    protected override async Task OnInitializedAsync()
    {
        var authState     = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserName   = authState.User.Identity?.Name ?? "Unknown";
        users              = await UserService.GetAllAsync();
        auditLogs          = await AuditService.GetRecentAsync();
        eventsToday        = await AuditService.GetTodayCountAsync();
        assignmentCounts   = await UserService.GetAssignmentCountsAsync();
        totalPropertyCount = (await PropertyService.GetAllAsync()).Count;
        loading            = false;
    }

    async Task OpenCreateForm()
    {
        editing              = new User { IsActive = true };
        password             = string.Empty;
        formError            = string.Empty;
        assignedPropertyIds  = new();
        allProperties        = await PropertyService.GetAllAsync();
        showForm             = true;
    }

    async Task OpenEditForm(User u)
    {
        editing = new User
        {
            Id = u.Id, FirstName = u.FirstName, LastName = u.LastName,
            Email = u.Email, Role = u.Role, IsActive = u.IsActive, PasswordHash = u.PasswordHash
        };
        originalRole         = u.Role;
        password             = string.Empty;
        formError            = string.Empty;
        allProperties        = await PropertyService.GetAllAsync();
        var ids              = await UserService.GetAssignedPropertyIdsAsync(u.Id);
        assignedPropertyIds  = ids.ToHashSet();
        originalPropertyIds  = ids.ToHashSet();
        showForm             = true;
    }

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(editing.FirstName) || string.IsNullOrWhiteSpace(editing.LastName) || string.IsNullOrWhiteSpace(editing.Email))
        {
            formError = "First name, last name, and email are required.";
            return;
        }
        if (editing.Id == 0 && string.IsNullOrWhiteSpace(password))
        {
            formError = "Password is required for new users.";
            return;
        }
        if (!string.IsNullOrWhiteSpace(password) && !PasswordIsValid)
        {
            formError = "Password does not meet all requirements.";
            return;
        }

        var emailExists = await UserService.EmailExistsAsync(editing.Email, editing.Id == 0 ? null : editing.Id);
        if (emailExists)
        {
            formError = "This email address is already associated with another account.";
            return;
        }

        bool isNew = editing.Id == 0;
        if (isNew)
        {
            await UserService.CreateAsync(editing, password);
            await AuditService.LogAsync("User Created", editing.FullName, editing.Email, currentUserName, $"Role: {editing.Role}");
        }
        else
        {
            await UserService.UpdateAsync(editing, string.IsNullOrWhiteSpace(password) ? null : password);

            var details = editing.Role != originalRole
                ? $"Role changed: {originalRole} → {editing.Role}"
                : $"Role: {editing.Role}";

            if (!string.IsNullOrWhiteSpace(password))
                details += " · Password updated";

            await AuditService.LogAsync("User Updated", editing.FullName, editing.Email, currentUserName, details);
        }

        if (editing.Role != UserRole.Administrator)
        {
            await UserService.SetPropertyAssignmentsAsync(editing.Id, assignedPropertyIds);

            if (!isNew && !assignedPropertyIds.SetEquals(originalPropertyIds))
            {
                var oldAccess = originalPropertyIds.Count == 0 ? "All properties" : $"{originalPropertyIds.Count} properties";
                var newAccess = assignedPropertyIds.Count  == 0 ? "All properties" : $"{assignedPropertyIds.Count} properties";
                await AuditService.LogAsync("Access Changed", editing.FullName, editing.Email, currentUserName,
                    $"Property access: {oldAccess} → {newAccess}");
            }
        }

        showForm   = false;
        successMsg = isNew ? "User created successfully." : "User updated successfully.";
        users      = await UserService.GetAllAsync();
        auditLogs  = await AuditService.GetRecentAsync();
        eventsToday = await AuditService.GetTodayCountAsync();
        assignmentCounts = await UserService.GetAssignmentCountsAsync();
    }

    void ConfirmDisable(User u) => pendingDisable = u;

    async Task Deactivate()
    {
        if (pendingDisable == null) return;
        await UserService.DeactivateAsync(pendingDisable.Id);
        await AuditService.LogAsync("User Deactivated", pendingDisable.FullName, pendingDisable.Email, currentUserName);
        successMsg       = "User deactivated.";
        pendingDisable   = null;
        users            = await UserService.GetAllAsync();
        auditLogs        = await AuditService.GetRecentAsync();
        eventsToday      = await AuditService.GetTodayCountAsync();
        assignmentCounts = await UserService.GetAssignmentCountsAsync();
    }

    async Task Activate(User u)
    {
        await UserService.ActivateAsync(u.Id);
        await AuditService.LogAsync("User Activated", u.FullName, u.Email, currentUserName);
        successMsg       = "User activated.";
        users            = await UserService.GetAllAsync();
        auditLogs        = await AuditService.GetRecentAsync();
        eventsToday      = await AuditService.GetTodayCountAsync();
        assignmentCounts = await UserService.GetAssignmentCountsAsync();
    }

    void OnUserFilterChanged() { userPage = 1; }
    void OnLogFilterChanged()  { logPage  = 1; }

    record PasswordRequirement(string Label, bool Met);

    IEnumerable<PasswordRequirement> PasswordRequirements => new[]
    {
        new PasswordRequirement("At least 8 characters",          password.Length >= 8),
        new PasswordRequirement("One uppercase letter (A–Z)",     password.Any(char.IsUpper)),
        new PasswordRequirement("One lowercase letter (a–z)",     password.Any(char.IsLower)),
        new PasswordRequirement("One number (0–9)",               password.Any(char.IsDigit)),
        new PasswordRequirement("One special character (!@#$%&*)", password.Any(c => "!@#$%^&*()_+-=[]{}|;':\",./<>?".Contains(c))),
    };

    bool PasswordIsValid => PasswordRequirements.All(r => r.Met);

    void ToggleProperty(int propId, bool isChecked)
    {
        if (isChecked) assignedPropertyIds.Add(propId);
        else assignedPropertyIds.Remove(propId);
    }

    static string Initials(User u) =>
        $"{(u.FirstName.Length > 0 ? u.FirstName[0] : ' ')}{(u.LastName.Length > 0 ? u.LastName[0] : ' ')}".ToUpper();

    static string RelativeTime(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalSeconds < 60)  return "just now";
        if (diff.TotalMinutes < 60)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24)  return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 7)   return $"{(int)diff.TotalDays}d ago";
        return utc.ToString("dd MMM yyyy");
    }

