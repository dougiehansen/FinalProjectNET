@page "/reports"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator,PropertyManager,AccountingTeam")]
@inject IPropertyService PropertyService

<PageTitle>Reports - PropertyMS</PageTitle>

<div class="page-wrap">

    <div class="page-hdr">
        <div>
            <h1>Reports</h1>
            <p>Generate and export property management reports</p>
        </div>
    </div>

    <div class="content-card panel" style="margin-bottom:20px;">
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:14px;">
            <div class="field-row c2">
                <div class="field-group">
                    <label class="field-label">Report Type</label>
                    <select class="field-select" @bind="selectedReport">
                        <option value="OccupancySummary">Occupancy Summary</option>
                        <option value="RentRoll">Rent Roll</option>
                        <option value="OutstandingPayments">Outstanding Payments</option>
                        <option value="MaintenanceLog">Maintenance Log</option>
                    </select>
                </div>
                <div class="field-group">
                    <label class="field-label">Property</label>
                    <select class="field-select" @bind="selectedPropertyId">
                        <option value="0">All Properties</option>
                        @foreach (var p in properties)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
            </div>
            @if (selectedReport == "MaintenanceLog")
            {
                <div class="field-row c2">
                    <div class="field-group">
                        <label class="field-label">From</label>
                        <input class="field-input" type="date" @bind="dateFrom" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">To</label>
                        <input class="field-input" type="date" @bind="dateTo" />
                    </div>
                </div>
            }
            <div style="display:flex;gap:8px;">
                <button class="btn-save" @onclick="RunReport">Generate</button>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div style="display:flex;justify-content:center;padding:32px;">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (hasRun)
    {
        <div class="empty-state">
            <h3>Coming soon</h3>
            <p>Report data will appear here once the service layer is connected.</p>
        </div>
    }

</div>

@code {
    bool loading, hasRun;
    string selectedReport = "OccupancySummary";
    int selectedPropertyId;
    DateTime? dateFrom, dateTo;
    List<Property> properties = new();

    protected override async Task OnInitializedAsync()
    {
        properties = await PropertyService.GetAllAsync();
    }

    async Task RunReport()
    {
        loading = true;
        await Task.Delay(300);
        loading = false;
        hasRun = true;
    }
}
