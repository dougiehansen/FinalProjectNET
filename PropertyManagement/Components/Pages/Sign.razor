@page "/sign/{Token}"
@layout SignLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject ILeaseService LeaseService
@inject IDocumentService DocumentService
@inject PropertyManagement.Services.LeaseNotificationService NotificationService
@inject IHttpContextAccessor HttpContextAccessor
@using PropertyManagement.Models

<PageTitle>@(lease is null ? "Lease Signing" : $"Sign Lease — {lease.Unit?.Property?.Name}") — PropertyMS</PageTitle>

<div class="sign-wrap">

    <div class="sign-brand">
        <div class="sign-brand-inner">
            <img src="/images/keyport-icon.svg" width="36" height="36" alt="PropertyMS" />
            <span class="sign-brand-name">PropertyMS</span>
        </div>
    </div>

    @if (loading)
    {
        <div class="sign-loading">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (lease is null)
    {
        <div class="sign-status-card">
            <div class="sign-status-icon">🔗</div>
            <h2>Invalid Signing Link</h2>
            <p>This link is invalid or has already expired. Please contact your property manager.</p>
        </div>
    }
    else if (lease.SignatureStatus == SignatureStatus.Signed)
    {
        <div class="sign-status-card">
            <div class="sign-status-icon">✅</div>
            <h2 class="text-green">Lease Already Signed</h2>
            <p>Signed by <strong>@lease.SignedByName</strong></p>
            <p>on @lease.SignedAt?.ToString("dd MMM yyyy 'at' HH:mm") UTC</p>
        </div>
    }
    else if (lease.SignatureStatus == SignatureStatus.Declined)
    {
        <div class="sign-status-card">
            <div class="sign-status-icon">❌</div>
            <h2 class="text-red">Lease Declined</h2>
            <p>You have already declined this lease. Please contact your property manager if this was a mistake.</p>
        </div>
    }
    else if (done)
    {
        <div class="sign-status-card">
            <div class="sign-status-icon">✅</div>
            <h2 class="text-green">Lease Signed Successfully</h2>
            <p>Thank you, <strong>@signedByName</strong>. Your signed lease has been recorded. You will receive a copy from your property manager.</p>
        </div>
    }
    else if (declined)
    {
        <div class="sign-status-card">
            <div class="sign-status-icon">❌</div>
            <h2 class="text-red">Lease Declined</h2>
            <p>You have declined this lease. Your property manager has been notified.</p>
        </div>
    }
    else
    {
        <div class="sign-card">
            <div class="sign-card-hdr">
                <h1>Residential Lease Agreement</h1>
                <p>Please review the terms below and sign or decline.</p>
            </div>

            <table class="lease-detail-table">
                <tr><td>Tenant</td>         <td>@lease.Tenant.FullName</td></tr>
                <tr><td>Property</td>        <td>@lease.Unit.Property.Name</td></tr>
                <tr><td>Address</td>         <td>@lease.Unit.Property.Address, @lease.Unit.Property.City</td></tr>
                <tr><td>Unit</td>            <td>@lease.Unit.UnitNumber</td></tr>
                <tr><td>Lease Start</td>     <td>@lease.StartDate.ToString("dd MMM yyyy")</td></tr>
                <tr><td>Lease End</td>       <td>@lease.EndDate.ToString("dd MMM yyyy")</td></tr>
                <tr><td>Monthly Rent</td>    <td>€@lease.MonthlyRent.ToString("N2")</td></tr>
                <tr><td>Security Deposit</td><td>€@lease.SecurityDeposit.ToString("N2")</td></tr>
            </table>

            <h3 class="sign-terms-title">Terms and Conditions</h3>
            <div class="sign-terms">
                <p><strong>1. Rent Payment.</strong> The tenant agrees to pay the monthly rent of €@lease.MonthlyRent.ToString("N2") on or before the 1st day of each calendar month.</p>
                <p><strong>2. Security Deposit.</strong> A security deposit of €@lease.SecurityDeposit.ToString("N2") is held against damage beyond normal wear and tear and will be returned within 30 days of lease end.</p>
                <p><strong>3. Property Use.</strong> The tenant shall use the property solely as a private residence and shall not sublet without written consent from the landlord.</p>
                <p><strong>4. Maintenance.</strong> The tenant shall keep the premises in a clean and sanitary condition and report any maintenance issues promptly.</p>
                <p><strong>5. Termination.</strong> Either party may terminate this agreement with 60 days written notice prior to the end date.</p>
            </div>
        </div>

        <div class="sign-card">
            <h3 class="sign-sig-title">Digital Signature</h3>
            <p class="sign-sig-desc">By entering your full name and clicking <strong>Sign Lease</strong>, you agree to the terms above and confirm this acts as your digital signature.</p>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="sign-error">@errorMsg</div>
            }

            <div class="sign-field-wrap">
                <label class="sign-field-label">Full Name *</label>
                <input class="sign-field-input"
                       type="text"
                       placeholder="Enter your full name exactly as it appears above"
                       @bind="signedByName"
                       disabled="@submitting" />
            </div>

            <div class="sign-actions">
                <button class="btn-sign" @onclick="SubmitSignature" disabled="@submitting">
                    @(submitting ? "Signing…" : "✓ Sign Lease")
                </button>
                <button class="btn-decline" @onclick="Decline" disabled="@submitting">
                    Decline
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    Lease? lease;
    bool loading = true, submitting, done, declined;
    string signedByName = string.Empty, errorMsg = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        lease = await LeaseService.GetByTokenAsync(Token);
        loading = false;

        if (lease is { SignatureStatus: SignatureStatus.Pending })
        {
            var ctx       = HttpContextAccessor.HttpContext;
            var ip        = ctx?.Connection.RemoteIpAddress?.ToString();
            var userAgent = ctx?.Request.Headers.UserAgent.ToString();

            await LeaseService.RecordSigningOpenedAsync(Token, ip, userAgent);
            _ = NotificationService.NotifyAsync(new(
                lease.Id,
                lease.Tenant.FullName,
                $"{lease.Unit.Property.Name} — Unit {lease.Unit.UnitNumber}",
                ip, userAgent,
                DateTime.UtcNow,
                IsSigned: false));
        }
    }

    async Task SubmitSignature()
    {
        errorMsg = string.Empty;

        if (string.IsNullOrWhiteSpace(signedByName))
        {
            errorMsg = "Please enter your full name to sign.";
            return;
        }

        submitting = true;
        await LeaseService.SignAsync(Token, signedByName.Trim());

        lease = await LeaseService.GetByTokenAsync(Token);
        if (lease is not null)
        {
            try { await DocumentService.UploadSignedDocumentAsync(lease); } catch { }

            _ = NotificationService.NotifyAsync(new(
                lease.Id,
                lease.Tenant.FullName,
                $"{lease.Unit.Property.Name} — Unit {lease.Unit.UnitNumber}",
                lease.TenantIpAddress,
                lease.TenantUserAgent,
                DateTime.UtcNow,
                IsSigned: true));
        }

        done       = true;
        submitting = false;
    }

    async Task Decline()
    {
        submitting = true;
        await LeaseService.DeclineAsync(Token);
        declined   = true;
        submitting = false;
    }
}
