@page "/rent-payments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator,PropertyManager,AccountingTeam")]
@inject IRentPaymentService RentPaymentService
@inject ILeaseService LeaseService
@inject AuthenticationStateProvider AuthStateProvider
@inject IPropertyAccessService AccessService

<PageTitle>Rent Payments - PropertyMS</PageTitle>

<div class="page-wrap">

    <div class="page-hdr">
        <div>
            <h1>Rent Payments</h1>
            <p>@payments.Count @(payments.Count == 1 ? "payment" : "payments") recorded</p>
        </div>
        <button class="btn-primary-action" @onclick="OpenForm">
            <svg width="14" height="14" fill="none" viewBox="0 0 14 14">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Record Payment
        </button>
    </div>

    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div class="alert alert-success alert-dismissible">@successMsg
            <button type="button" class="btn-close" @onclick="() => successMsg = string.Empty"></button>
        </div>
    }

    <!-- Active lease balances summary -->
    @if (!loading)
    {
        <div class="content-card panel" style="margin-bottom:20px;">
            <div style="padding:16px 20px;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;gap:8px;">
                <span style="font-weight:700;font-size:15px;color:#1c1c1e;">Active Lease Balances</span>
                @if (activeLeases.Any(l => leaseBalances.GetValueOrDefault(l.Id) > 0))
                {
                    <span style="background:#dc2626;color:#fff;border-radius:999px;padding:2px 9px;font-size:12px;font-weight:700;">
                        @activeLeases.Count(l => leaseBalances.GetValueOrDefault(l.Id) > 0) overdue
                    </span>
                }
            </div>
            @if (!activeLeases.Any())
            {
                <p style="color:#6b7280;padding:16px 20px;margin:0;">No active leases.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Tenant</th>
                                <th>Property</th>
                                <th>Unit</th>
                                <th>Monthly Rent</th>
                                <th>Due Date</th>
                                <th>Outstanding</th>
                                <th style="text-align:right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in activeLeases)
                            {
                                var balance = leaseBalances.GetValueOrDefault(l.Id);
                                var due = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                                var isOverdue = balance > 0 && DateTime.Today > due;
                                <tr style="@(balance > 0 ? "background:#fef2f2;" : "")">
                                    <td>
                                        <div class="user-cell">
                                            <div class="user-initials">@l.Tenant.FirstName[0]@l.Tenant.LastName[0]</div>
                                            <strong>@l.Tenant.FullName</strong>
                                        </div>
                                    </td>
                                    <td>@l.Unit.Property.Name</td>
                                    <td>@l.Unit.UnitNumber</td>
                                    <td>€@l.MonthlyRent.ToString("N2")</td>
                                    <td>
                                        @due.ToString("1 MMM yyyy")
                                        @if (isOverdue)
                                        {
                                            <span class="status-badge expired" style="margin-left:6px;font-size:0.72rem;">Overdue</span>
                                        }
                                    </td>
                                    <td>
                                        @if (balance > 0)
                                        {
                                            <span class="status-badge expired">€@balance.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge active">Paid up</span>
                                        }
                                    </td>
                                    <td style="text-align:right;">
                                        <button class="btn-action sm" @onclick="() => OpenFormForLease(l)">Record Payment</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- Future payment schedule -->
    @if (!loading)
    {
        var schedule = GenerateSchedule();
        var years = schedule.Select(p => p.DueDate.Year).Distinct().OrderBy(y => y).ToList();
        var filtered = schedule.Where(p => p.DueDate.Year == scheduleYear).ToList();

        <div class="content-card panel" style="margin-bottom:20px;">
            <div style="padding:16px 20px;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <span style="font-weight:700;font-size:15px;color:#1c1c1e;">Payment Schedule</span>
                <select style="padding:4px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;"
                        value="@scheduleYear" @onchange="e => scheduleYear = int.Parse(e.Value!.ToString()!)">
                    @foreach (var y in years)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                <span style="color:#6b7280;font-size:13px;">@filtered.Count payments · €@filtered.Sum(p => p.Lease.MonthlyRent).ToString("N2") total</span>
            </div>
            @if (!filtered.Any())
            {
                <p style="color:#6b7280;padding:16px 20px;margin:0;">No scheduled payments for this year.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Due Date</th>
                                <th>Tenant</th>
                                <th>Property</th>
                                <th>Unit</th>
                                <th>Amount</th>
                                <th style="text-align:right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in filtered)
                            {
                                <tr>
                                    <td>@p.DueDate.ToString("1 MMM yyyy")</td>
                                    <td>
                                        <div class="user-cell">
                                            <div class="user-initials">@p.Lease.Tenant.FirstName[0]@p.Lease.Tenant.LastName[0]</div>
                                            <strong>@p.Lease.Tenant.FullName</strong>
                                        </div>
                                    </td>
                                    <td>@p.Lease.Unit.Property.Name</td>
                                    <td>@p.Lease.Unit.UnitNumber</td>
                                    <td style="font-weight:600;">€@p.Lease.MonthlyRent.ToString("N2")</td>
                                    <td style="text-align:right;">
                                        <button class="btn-action sm" @onclick="() => OpenFormForLease(p.Lease, p.DueDate)">Record Payment</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- Payment history -->
    <div class="content-card panel">
        <div style="padding:16px 20px;border-bottom:1px solid #e5e7eb;">
            <span style="font-weight:700;font-size:15px;color:#1c1c1e;">Payment History</span>
        </div>
        @if (loading)
        {
            <div class="d-flex justify-content-center py-4"><div class="spinner-border text-primary"></div></div>
        }
        else if (!payments.Any())
        {
            <p style="color:#6b7280;padding:16px 20px;margin:0;">No payments recorded yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tenant</th><th>Property</th><th>Unit</th><th>Amount</th>
                            <th>Date</th><th>Method</th><th>Outstanding</th><th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in payments)
                        {
                            <tr>
                                <td>@p.Lease.Tenant.FullName</td>
                                <td>@p.Lease.Unit.Property.Name</td>
                                <td>@p.Lease.Unit.UnitNumber</td>
                                <td style="color:#16a34a;font-weight:600;">€@p.Amount.ToString("N2")</td>
                                <td>@p.PaymentDate.ToString("dd MMM yyyy")</td>
                                <td>@p.PaymentMethod</td>
                                <td>
                                    @if (p.OutstandingBalance > 0)
                                    {
                                        <span class="status-badge expired">€@p.OutstandingBalance.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge active">Paid</span>
                                    }
                                </td>
                                <td style="color:#6b7280;font-size:13px;">@p.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@if (showForm)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Record Rent Payment</h5>
                    <button type="button" class="btn-close" @onclick="() => showForm = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="alert alert-danger">@formError</div>
                    }
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Lease / Tenant *</label>
                            <select class="form-select" @bind="editing.LeaseId" @bind:after="OnLeaseSelected">
                                <option value="0">Select lease...</option>
                                @foreach (var l in activeLeases)
                                {
                                    <option value="@l.Id">@l.Tenant.FullName – @l.Unit.Property.Name @l.Unit.UnitNumber (&#8364;@l.MonthlyRent/mo)</option>
                                }
                            </select>
                        </div>

                        @if (selectedLease != null)
                        {
                            <div class="col-12">
                                <div class="alert alert-info mb-0 py-2">
                                    Current outstanding balance:
                                    <strong>&#8364;@currentBalance.ToString("N2")</strong>
                                </div>
                            </div>
                        }

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Amount (&#8364;) *</label>
                            <input class="form-control" type="number" @bind="editing.Amount" step="0.01" min="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Payment Date *</label>
                            <input class="form-control" type="date" @bind="editing.PaymentDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Payment Method</label>
                            <select class="form-select" @bind="editing.PaymentMethod">
                                @foreach (var m in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Notes</label>
                            <input class="form-control" @bind="editing.Notes" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="Save">Record Payment</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    record ScheduledPayment(DateTime DueDate, Lease Lease);

    bool loading = true, showForm;
    HashSet<int>? allowedIds;
    List<RentPayment> payments = new();
    List<Lease> activeLeases = new();
    Dictionary<int, decimal> leaseBalances = new();
    RentPayment editing = new();
    Lease? selectedLease;
    decimal currentBalance;
    string successMsg = string.Empty, formError = string.Empty;
    int currentUserId;
    int scheduleYear = DateTime.Today.Year;

    List<ScheduledPayment> GenerateSchedule()
    {
        var result = new List<ScheduledPayment>();
        var startFrom = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        foreach (var l in activeLeases)
        {
            var date = startFrom;
            while (date <= l.EndDate)
            {
                result.Add(new(date, l));
                date = date.AddMonths(1);
            }
        }
        return result.OrderBy(p => p.DueDate).ThenBy(p => p.Lease.Tenant.FullName).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out currentUserId);
        allowedIds = await AccessService.GetAllowedIdsAsync(state.User);

        var allPayments = await RentPaymentService.GetAllAsync();
        payments = allowedIds == null ? allPayments : allPayments.Where(p => allowedIds.Contains(p.Lease.Unit.PropertyId)).ToList();
        var allLeases = await LeaseService.GetAllAsync();
        activeLeases = allLeases.Where(l => l.Status == LeaseStatus.Active && (allowedIds == null || allowedIds.Contains(l.Unit.PropertyId))).ToList();
        await LoadBalances();
        loading = false;
    }

    async Task LoadBalances()
    {
        leaseBalances = new();
        foreach (var l in activeLeases)
            leaseBalances[l.Id] = await LeaseService.GetOutstandingBalanceAsync(l.Id);
    }

    void OpenForm()
    {
        editing = new RentPayment { PaymentDate = DateTime.Today, PaymentMethod = PaymentMethod.BankTransfer };
        selectedLease = null;
        currentBalance = 0;
        formError = string.Empty;
        showForm = true;
    }

    void OpenFormForLease(Lease l, DateTime? dueDate = null)
    {
        var date = dueDate ?? DateTime.Today;
        var isPrepayment = date > DateTime.Today;
        editing = new RentPayment { LeaseId = l.Id, PaymentDate = date, PaymentMethod = PaymentMethod.BankTransfer, Amount = l.MonthlyRent,
            Notes = isPrepayment ? $"Prepayment for {date:MMMM yyyy}" : string.Empty };
        selectedLease = l;
        currentBalance = leaseBalances.GetValueOrDefault(l.Id);
        formError = string.Empty;
        showForm = true;
    }

    async Task OnLeaseSelected()
    {
        selectedLease = activeLeases.FirstOrDefault(l => l.Id == editing.LeaseId);
        if (selectedLease != null)
        {
            currentBalance = await LeaseService.GetOutstandingBalanceAsync(selectedLease.Id);
            if (editing.Amount == 0)
                editing.Amount = selectedLease.MonthlyRent;
        }
    }

    async Task Save()
    {
        if (editing.LeaseId == 0)
        {
            formError = "Please select a lease.";
            return;
        }
        if (editing.Amount <= 0)
        {
            formError = "Payment amount must be greater than zero.";
            return;
        }

        editing.RecordedByUserId = currentUserId;
        await RentPaymentService.RecordPaymentAsync(editing);

        showForm = false;
        successMsg = "Payment recorded successfully.";
        var allPayments = await RentPaymentService.GetAllAsync();
        payments = allowedIds == null ? allPayments : allPayments.Where(p => allowedIds.Contains(p.Lease.Unit.PropertyId)).ToList();
        await LoadBalances();
    }
}
