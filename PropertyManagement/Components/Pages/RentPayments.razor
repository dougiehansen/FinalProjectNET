@page "/rent-payments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator,PropertyManager,AccountingTeam")]
@inject IRentPaymentService RentPaymentService
@inject ILeaseService LeaseService
@inject AuthenticationStateProvider AuthStateProvider
@inject IPropertyAccessService AccessService
@inject BankStatementParser StatementParser
@inject StatementMatcherService StatementMatcher

<PageTitle>Rent Payments - PropertyMS</PageTitle>

<div class="page-wrap">

    <div class="page-hdr">
        <div>
            <h1>Rent Payments</h1>
            <p>@payments.Count @(payments.Count == 1 ? "payment" : "payments") recorded</p>
        </div>
        <div style="display:flex;gap:10px;">
            <button class="btn-primary-action" style="background:#f1f5f9;color:#374151;border:1px solid #e2e8f0;" @onclick="OpenImport">
                <svg width="14" height="14" fill="none" viewBox="0 0 14 14"><path d="M7 1v8M4 6l3 3 3-3M2 10v2a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Import Statement
            </button>
            <button class="btn-primary-action" @onclick="OpenForm">
                <svg width="14" height="14" fill="none" viewBox="0 0 14 14">
                    <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Record Payment
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div class="alert alert-success alert-dismissible">@successMsg
            <button type="button" class="btn-close" @onclick="() => successMsg = string.Empty"></button>
        </div>
    }

    <!-- Active lease balances summary -->
    @if (!loading)
    {
        <div class="content-card panel" style="margin-bottom:20px;">
            <div style="padding:16px 20px;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;gap:8px;">
                <span style="font-weight:700;font-size:15px;color:#1c1c1e;">Active Lease Balances</span>
                @if (activeLeases.Any(l => leaseBalances.GetValueOrDefault(l.Id) > 0))
                {
                    <span style="background:#dc2626;color:#fff;border-radius:999px;padding:2px 9px;font-size:12px;font-weight:700;">
                        @activeLeases.Count(l => leaseBalances.GetValueOrDefault(l.Id) > 0) overdue
                    </span>
                }
            </div>
            @if (!activeLeases.Any())
            {
                <p style="color:#6b7280;padding:16px 20px;margin:0;">No active leases.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Tenant</th>
                                <th>Property</th>
                                <th>Unit</th>
                                <th>Monthly Rent</th>
                                <th>Due Date</th>
                                <th>Outstanding</th>
                                <th style="text-align:right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in activeLeases)
                            {
                                var balance = leaseBalances.GetValueOrDefault(l.Id);
                                var due = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                                var isOverdue = balance > 0 && DateTime.Today > due;
                                <tr style="@(balance > 0 ? "background:#fef2f2;" : "")">
                                    <td>
                                        <div class="user-cell">
                                            <div class="user-initials">@l.Tenant.FirstName[0]@l.Tenant.LastName[0]</div>
                                            <strong>@l.Tenant.FullName</strong>
                                        </div>
                                    </td>
                                    <td>@l.Unit.Property.Name</td>
                                    <td>@l.Unit.UnitNumber</td>
                                    <td>€@l.MonthlyRent.ToString("N2")</td>
                                    <td>
                                        @due.ToString("1 MMM yyyy")
                                        @if (isOverdue)
                                        {
                                            <span class="status-badge expired" style="margin-left:6px;font-size:0.72rem;">Overdue</span>
                                        }
                                    </td>
                                    <td>
                                        @if (balance > 0)
                                        {
                                            <span class="status-badge expired">€@balance.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge active">Paid up</span>
                                        }
                                    </td>
                                    <td style="text-align:right;">
                                        <button class="btn-action sm" @onclick="() => OpenFormForLease(l)">Record Payment</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- Future payment schedule -->
    @if (!loading)
    {
        var schedule = GenerateSchedule();
        var years = schedule.Select(p => p.DueDate.Year).Distinct().OrderBy(y => y).ToList();
        var filtered = schedule.Where(p => p.DueDate.Year == scheduleYear).ToList();

        <div class="content-card panel" style="margin-bottom:20px;">
            <div style="padding:16px 20px;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <span style="font-weight:700;font-size:15px;color:#1c1c1e;">Payment Schedule</span>
                <select style="padding:4px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;"
                        value="@scheduleYear" @onchange="e => scheduleYear = int.Parse(e.Value!.ToString()!)">
                    @foreach (var y in years)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                <span style="color:#6b7280;font-size:13px;">@filtered.Count payments · €@filtered.Sum(p => p.Lease.MonthlyRent).ToString("N2") total</span>
            </div>
            @if (!filtered.Any())
            {
                <p style="color:#6b7280;padding:16px 20px;margin:0;">No scheduled payments for this year.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Due Date</th>
                                <th>Tenant</th>
                                <th>Property</th>
                                <th>Unit</th>
                                <th>Amount</th>
                                <th style="text-align:right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in filtered)
                            {
                                <tr>
                                    <td>@p.DueDate.ToString("1 MMM yyyy")</td>
                                    <td>
                                        <div class="user-cell">
                                            <div class="user-initials">@p.Lease.Tenant.FirstName[0]@p.Lease.Tenant.LastName[0]</div>
                                            <strong>@p.Lease.Tenant.FullName</strong>
                                        </div>
                                    </td>
                                    <td>@p.Lease.Unit.Property.Name</td>
                                    <td>@p.Lease.Unit.UnitNumber</td>
                                    <td style="font-weight:600;">€@p.Lease.MonthlyRent.ToString("N2")</td>
                                    <td style="text-align:right;">
                                        <button class="btn-action sm" @onclick="() => OpenFormForLease(p.Lease, p.DueDate)">Record Payment</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- Payment history -->
    <div class="content-card panel">
        <div style="padding:16px 20px;border-bottom:1px solid #e5e7eb;">
            <span style="font-weight:700;font-size:15px;color:#1c1c1e;">Payment History</span>
        </div>
        @if (loading)
        {
            <div class="d-flex justify-content-center py-4"><div class="spinner-border text-primary"></div></div>
        }
        else if (!payments.Any())
        {
            <p style="color:#6b7280;padding:16px 20px;margin:0;">No payments recorded yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tenant</th><th>Property</th><th>Unit</th><th>Amount</th>
                            <th>Date</th><th>Method</th><th>Outstanding</th><th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in payments)
                        {
                            <tr>
                                <td>@p.Lease.Tenant.FullName</td>
                                <td>@p.Lease.Unit.Property.Name</td>
                                <td>@p.Lease.Unit.UnitNumber</td>
                                <td style="color:#16a34a;font-weight:600;">€@p.Amount.ToString("N2")</td>
                                <td>@p.PaymentDate.ToString("dd MMM yyyy")</td>
                                <td>@p.PaymentMethod</td>
                                <td>
                                    @if (p.OutstandingBalance > 0)
                                    {
                                        <span class="status-badge expired">€@p.OutstandingBalance.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge active">Paid</span>
                                    }
                                </td>
                                <td style="color:#6b7280;font-size:13px;">@p.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@* ── Bank Statement Import ── *@
@if (showImport)
{
    <div class="modal-overlay" @onclick="CloseImport"></div>
    <div class="modal-sheet" style="align-items:center;">
        <div class="modal-box" style="max-width:860px;width:95vw;" @onclick:stopPropagation="true">
            <div class="modal-top">
                <h2>Import Bank Statement</h2>
                <button class="modal-close" @onclick="CloseImport">✕</button>
            </div>

            <div class="modal-body-inner">

                @* Step 1 — file upload *@
                @if (!matchResults.Any())
                {
                    <div style="display:flex;flex-direction:column;gap:16px;">
                        <p style="font-size:0.88rem;color:#6b7280;margin:0;">
                            Upload a <strong>CSV bank statement</strong>. The parser supports exports from AIB, Bank of Ireland, Revolut, and most standard formats. Only credit (incoming) rows are processed.
                        </p>
                        <div class="field-group">
                            <label class="field-label">Select CSV file</label>
                            <InputFile class="field-input" accept=".csv" OnChange="HandleStatementFile" style="padding:6px;" />
                        </div>
                        @if (!string.IsNullOrEmpty(importErr))
                        {
                            <div class="field-error">@importErr</div>
                        }
                        @if (importLoading)
                        {
                            <div style="display:flex;align-items:center;gap:10px;color:#6b7280;font-size:0.88rem;">
                                <div class="spinner" style="width:16px;height:16px;"></div> Parsing…
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* Step 2 — review matches *@
                    var toImport = matchResults.Count(r => r.Confirmed && r.SelectedLeaseId > 0);
                    var skipped  = matchResults.Count - toImport;

                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap;">
                        <span style="font-size:0.85rem;color:#6b7280;">
                            <strong style="color:#1c1c1e;">@matchResults.Count</strong> transactions found
                        </span>
                        <span style="background:#dcfce7;color:#16a34a;padding:3px 10px;border-radius:999px;font-size:0.78rem;font-weight:700;">
                            @matchResults.Count(r => r.MatchedLease != null) auto-matched
                        </span>
                        <span style="background:#fef9c3;color:#b45309;padding:3px 10px;border-radius:999px;font-size:0.78rem;font-weight:700;">
                            @matchResults.Count(r => r.MatchedLease == null) need review
                        </span>
                        <button style="margin-left:auto;background:none;border:none;font-size:0.82rem;color:#6b7280;cursor:pointer;text-decoration:underline;" @onclick="ResetImport">
                            Upload different file
                        </button>
                    </div>

                    <div style="max-height:420px;overflow-y:auto;border:1px solid #e5e7eb;border-radius:10px;">
                        <table style="width:100%;border-collapse:collapse;font-size:0.84rem;">
                            <thead style="position:sticky;top:0;background:#f8fafc;z-index:1;">
                                <tr>
                                    <th style="padding:10px 12px;text-align:left;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:#94a3b8;font-weight:700;border-bottom:1px solid #e5e7eb;">Include</th>
                                    <th style="padding:10px 12px;text-align:left;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:#94a3b8;font-weight:700;border-bottom:1px solid #e5e7eb;">Date</th>
                                    <th style="padding:10px 12px;text-align:left;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:#94a3b8;font-weight:700;border-bottom:1px solid #e5e7eb;">Amount</th>
                                    <th style="padding:10px 12px;text-align:left;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:#94a3b8;font-weight:700;border-bottom:1px solid #e5e7eb;">Description</th>
                                    <th style="padding:10px 12px;text-align:left;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:#94a3b8;font-weight:700;border-bottom:1px solid #e5e7eb;">Match Lease</th>
                                    <th style="padding:10px 12px;text-align:left;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:#94a3b8;font-weight:700;border-bottom:1px solid #e5e7eb;">Confidence</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in matchResults)
                                {
                                    var rowBg = r.MatchedLease != null ? "#f0fdf4" : "#fffbeb";
                                    <tr style="background:@rowBg;border-bottom:1px solid #f1f5f9;">
                                        <td style="padding:10px 12px;">
                                            <input type="checkbox" checked="@r.Confirmed"
                                                   @onchange="e => r.Confirmed = (bool)(e.Value ?? false)"
                                                   style="width:16px;height:16px;cursor:pointer;" />
                                        </td>
                                        <td style="padding:10px 12px;white-space:nowrap;color:#374151;">
                                            @r.Transaction.Date.ToString("dd MMM yyyy")
                                        </td>
                                        <td style="padding:10px 12px;font-weight:700;color:#16a34a;white-space:nowrap;">
                                            €@r.Transaction.Amount.ToString("N2")
                                        </td>
                                        <td style="padding:10px 12px;color:#6b7280;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                            title="@r.Transaction.Description @r.Transaction.Reference">
                                            @(string.IsNullOrEmpty(r.Transaction.Description) ? r.Transaction.Reference : r.Transaction.Description)
                                        </td>
                                        <td style="padding:10px 12px;min-width:220px;">
                                            <select style="width:100%;padding:5px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:0.82rem;"
                                                    value="@r.SelectedLeaseId"
                                                    @onchange="e => OnMatchLeaseChanged(r, e.Value)">
                                                <option value="0">— No match —</option>
                                                @foreach (var l in activeLeases)
                                                {
                                                    <option value="@l.Id">@l.Tenant.FullName – @l.Unit.UnitNumber (€@l.MonthlyRent/mo)</option>
                                                }
                                            </select>
                                            @if (r.Reasons.Any())
                                            {
                                                <div style="font-size:0.7rem;color:#94a3b8;margin-top:3px;">@string.Join(" · ", r.Reasons)</div>
                                            }
                                        </td>
                                        <td style="padding:10px 12px;">
                                            @{
                                                var (confBg, confClr) = r.ConfidenceLabel switch
                                                {
                                                    "High"   => ("#dcfce7", "#16a34a"),
                                                    "Medium" => ("#fef9c3", "#b45309"),
                                                    _        => ("#f1f5f9", "#94a3b8")
                                                };
                                            }
                                            <span style="padding:3px 9px;border-radius:999px;font-size:0.72rem;font-weight:700;background:@confBg;color:@confClr;">
                                                @r.ConfidenceLabel
                                            </span>
                                            <div style="font-size:0.7rem;color:#94a3b8;margin-top:2px;">score @r.Score</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div style="margin-top:12px;font-size:0.85rem;color:#6b7280;">
                        <strong style="color:#1c1c1e;">@toImport</strong> payment@(toImport == 1 ? "" : "s") will be recorded &nbsp;·&nbsp;
                        <strong>@skipped</strong> skipped
                    </div>
                }
            </div>

            @if (matchResults.Any())
            {
                <div class="modal-foot">
                    <button class="btn-cancel" @onclick="CloseImport">Cancel</button>
                    <button class="btn-save" @onclick="CommitImport" disabled="@importLoading">
                        @if (importLoading)
                        {
                            <span>Importing…</span>
                        }
                        else
                        {
                            var n = matchResults.Count(r => r.Confirmed && r.SelectedLeaseId > 0);
                            <span>Import @n Payment@(n == 1 ? "" : "s")</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (showForm)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Record Rent Payment</h5>
                    <button type="button" class="btn-close" @onclick="() => showForm = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="alert alert-danger">@formError</div>
                    }
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Lease / Tenant *</label>
                            <select class="form-select" @bind="editing.LeaseId" @bind:after="OnLeaseSelected">
                                <option value="0">Select lease...</option>
                                @foreach (var l in activeLeases)
                                {
                                    <option value="@l.Id">@l.Tenant.FullName – @l.Unit.Property.Name @l.Unit.UnitNumber (&#8364;@l.MonthlyRent/mo)</option>
                                }
                            </select>
                        </div>

                        @if (selectedLease != null)
                        {
                            <div class="col-12">
                                <div class="alert alert-info mb-0 py-2">
                                    Current outstanding balance:
                                    <strong>&#8364;@currentBalance.ToString("N2")</strong>
                                </div>
                            </div>
                        }

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Amount (&#8364;) *</label>
                            <input class="form-control" type="number" @bind="editing.Amount" step="0.01" min="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Payment Date *</label>
                            <input class="form-control" type="date" @bind="editing.PaymentDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Payment Method</label>
                            <select class="form-select" @bind="editing.PaymentMethod">
                                @foreach (var m in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Notes</label>
                            <input class="form-control" @bind="editing.Notes" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="Save">Record Payment</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    record ScheduledPayment(DateTime DueDate, Lease Lease);

    bool loading = true, showForm;
    bool showImport, importLoading;
    string importErr = string.Empty;
    List<MatchResult> matchResults = new();
    HashSet<int>? allowedIds;
    List<RentPayment> payments = new();
    List<Lease> activeLeases = new();
    Dictionary<int, decimal> leaseBalances = new();
    RentPayment editing = new();
    Lease? selectedLease;
    decimal currentBalance;
    string successMsg = string.Empty, formError = string.Empty;
    int currentUserId;
    int scheduleYear = DateTime.Today.Year;

    List<ScheduledPayment> GenerateSchedule()
    {
        var result = new List<ScheduledPayment>();
        var startFrom = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        foreach (var l in activeLeases)
        {
            var date = startFrom;
            while (date <= l.EndDate)
            {
                result.Add(new(date, l));
                date = date.AddMonths(1);
            }
        }
        return result.OrderBy(p => p.DueDate).ThenBy(p => p.Lease.Tenant.FullName).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out currentUserId);
        allowedIds = await AccessService.GetAllowedIdsAsync(state.User);

        var allPayments = await RentPaymentService.GetAllAsync();
        payments = allowedIds == null ? allPayments : allPayments.Where(p => allowedIds.Contains(p.Lease.Unit.PropertyId)).ToList();
        var allLeases = await LeaseService.GetAllAsync();
        activeLeases = allLeases.Where(l => l.Status == LeaseStatus.Active && (allowedIds == null || allowedIds.Contains(l.Unit.PropertyId))).ToList();
        await LoadBalances();
        loading = false;
    }

    async Task LoadBalances()
    {
        leaseBalances = new();
        foreach (var l in activeLeases)
            leaseBalances[l.Id] = await LeaseService.GetOutstandingBalanceAsync(l.Id);
    }

    void OpenForm()
    {
        editing = new RentPayment { PaymentDate = DateTime.Today, PaymentMethod = PaymentMethod.BankTransfer };
        selectedLease = null;
        currentBalance = 0;
        formError = string.Empty;
        showForm = true;
    }

    void OpenFormForLease(Lease l, DateTime? dueDate = null)
    {
        var date = dueDate ?? DateTime.Today;
        var isPrepayment = date > DateTime.Today;
        editing = new RentPayment { LeaseId = l.Id, PaymentDate = date, PaymentMethod = PaymentMethod.BankTransfer, Amount = l.MonthlyRent,
            Notes = isPrepayment ? $"Prepayment for {date:MMMM yyyy}" : string.Empty };
        selectedLease = l;
        currentBalance = leaseBalances.GetValueOrDefault(l.Id);
        formError = string.Empty;
        showForm = true;
    }

    async Task OnLeaseSelected()
    {
        selectedLease = activeLeases.FirstOrDefault(l => l.Id == editing.LeaseId);
        if (selectedLease != null)
        {
            currentBalance = await LeaseService.GetOutstandingBalanceAsync(selectedLease.Id);
            if (editing.Amount == 0)
                editing.Amount = selectedLease.MonthlyRent;
        }
    }

    async Task Save()
    {
        if (editing.LeaseId == 0)
        {
            formError = "Please select a lease.";
            return;
        }
        if (editing.Amount <= 0)
        {
            formError = "Payment amount must be greater than zero.";
            return;
        }

        editing.RecordedByUserId = currentUserId;
        await RentPaymentService.RecordPaymentAsync(editing);

        showForm = false;
        successMsg = "Payment recorded successfully.";
        var allPayments = await RentPaymentService.GetAllAsync();
        payments = allowedIds == null ? allPayments : allPayments.Where(p => allowedIds.Contains(p.Lease.Unit.PropertyId)).ToList();
        await LoadBalances();
    }

    // ── Bank Statement Import ──

    void OnMatchLeaseChanged(MatchResult r, object? value)
    {
        int.TryParse(value?.ToString(), out var id);
        r.SelectedLeaseId = id;
        r.Confirmed       = id > 0;
    }

    void OpenImport()
    {
        matchResults = [];
        importErr    = string.Empty;
        showImport   = true;
    }

    void CloseImport()  => showImport = false;
    void ResetImport()  { matchResults = []; importErr = string.Empty; }

    async Task HandleStatementFile(InputFileChangeEventArgs e)
    {
        importErr    = string.Empty;
        importLoading = true;

        try
        {
            var file = e.File;
            if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                importErr = "Only CSV files are supported.";
                return;
            }
            if (file.Size > 5 * 1024 * 1024)
            {
                importErr = "File must be under 5 MB.";
                return;
            }

            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var content      = await reader.ReadToEndAsync();

            var transactions = StatementParser.ParseCsv(content);

            if (transactions.Count == 0)
            {
                importErr = "No credit transactions found. Check the file is a valid CSV bank export with Date and Amount columns.";
                return;
            }

            matchResults = StatementMatcher.Match(transactions, activeLeases);
        }
        catch (Exception ex)
        {
            importErr = $"Could not parse file: {ex.Message}";
        }
        finally
        {
            importLoading = false;
        }
    }

    async Task CommitImport()
    {
        var toRecord = matchResults
            .Where(r => r.Confirmed && r.SelectedLeaseId > 0)
            .ToList();

        if (toRecord.Count == 0) return;

        importLoading = true;

        foreach (var r in toRecord)
        {
            var payment = new RentPayment
            {
                LeaseId         = r.SelectedLeaseId,
                Amount          = r.Transaction.Amount,
                PaymentDate     = r.Transaction.Date,
                PaymentMethod   = PaymentMethod.BankTransfer,
                Notes           = $"Imported from bank statement. Ref: {r.Transaction.Description}".Trim('.', ' '),
                RecordedByUserId = currentUserId,
            };
            await RentPaymentService.RecordPaymentAsync(payment);
        }

        showImport    = false;
        importLoading = false;
        matchResults  = [];
        successMsg    = $"{toRecord.Count} payment{(toRecord.Count == 1 ? "" : "s")} imported from bank statement.";

        var allPayments = await RentPaymentService.GetAllAsync();
        payments = allowedIds == null ? allPayments : allPayments.Where(p => allowedIds.Contains(p.Lease.Unit.PropertyId)).ToList();
        await LoadBalances();
    }
}
