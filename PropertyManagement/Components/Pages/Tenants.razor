@page "/tenants"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator,PropertyManager")]
@inject ITenantService TenantService
@inject ILeaseService LeaseService
@inject IRentPaymentService PaymentService
@inject IPropertyAccessService AccessService
@inject AuthenticationStateProvider AuthStateProvider
@using PropertyManagement.Services

<PageTitle>Tenants - PropertyMS</PageTitle>

<div class="page-wrap">

    <div class="page-hdr">
        <div>
            <h1>Tenants</h1>
            <p>@tenants.Count @(tenants.Count == 1 ? "tenant" : "tenants") &nbsp;·&nbsp; @tenants.Count(t => t.IsActive) active</p>
        </div>
        <button class="btn-primary-action" @onclick="() => OpenForm()">
            <svg width="14" height="14" fill="none" viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Add Tenant
        </button>
    </div>

    <div class="stats-grid g4">
        <div class="stat-card">
            <div class="stat-label">Total Tenants</div>
            <div class="stat-value">@tenants.Count</div>
            <div class="stat-sub">All records</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Active</div>
            <div class="stat-value">@tenants.Count(t => t.IsActive)</div>
            <div class="stat-sub">Current tenants</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Inactive</div>
            <div class="stat-value">@tenants.Count(t => !t.IsActive)</div>
            <div class="stat-sub">Former tenants</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">At Risk</div>
            <div class="stat-value text-red">@healthScores.Values.Count(s => s.Level == "Red")</div>
            <div class="stat-sub">@healthScores.Values.Count(s => s.Level == "Amber") expiring / no lease</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div class="alert-banner success">
            <span>@successMsg</span>
            <button class="btn-action sm" @onclick="() => successMsg = string.Empty">✕</button>
        </div>
    }

    <div class="content-card panel">
        @if (loading)
        {
            <div class="loading-row">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (!tenants.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">👤</div>
                <h3>No tenants yet</h3>
                <p>Add your first tenant to get started.</p>
            </div>
        }
        else
        {
            <div class="toolbar">
                <div class="search-wrap">
                    <svg width="15" height="15" fill="none" viewBox="0 0 15 15">
                        <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M10.5 10.5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    <input class="search-inp" placeholder="Search by name or email…"
                           value="@searchTerm" @oninput="e => searchTerm = e.Value?.ToString() ?? string.Empty" />
                </div>
                <select class="filter-select" @bind="statusFilter" @bind:after="ResetPage">
                    <option value="">All Statuses</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
                <select class="filter-select" @bind="healthFilter" @bind:after="ResetPage">
                    <option value="">All Health</option>
                    <option value="Green">✅ Good</option>
                    <option value="Amber">⚠️ Attention</option>
                    <option value="Red">🔴 At Risk</option>
                </select>
            </div>

            <div class="table-scroll" @onchange="ResetPage">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tenant</th>
                            <th>Phone</th>
                            <th>Employer</th>
                            <th>Status</th>
                            <th>Health</th>
                            <th class="td-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in PagedTenants)
                        {
                            <tr class="row-clickable" @onclick="() => OpenPanel(t)" @onclick:stopPropagation="false">
                                <td>
                                    <div class="user-cell">
                                        <div class="user-initials">@t.FirstName[0]@t.LastName[0]</div>
                                        <div class="user-meta">
                                            <strong>@t.FullName</strong>
                                            <span>@t.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="td-muted">@(string.IsNullOrEmpty(t.Phone) ? "—" : t.Phone)</td>
                                <td class="td-muted">@(string.IsNullOrEmpty(t.EmployerName) ? "—" : t.EmployerName)</td>
                                <td>
                                    <span class="status-badge @(t.IsActive ? "active" : "inactive")">
                                        @(t.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var hs = healthScores.GetValueOrDefault(t.Id);
                                    }
                                    @if (hs != null)
                                    {
                                        <span class="health-badge @(hs.Level == "Red" ? "red" : hs.Level == "Amber" ? "amber" : "green")"
                                              title="@hs.Reason">
                                            @(hs.Level == "Red" ? "🔴" : hs.Level == "Amber" ? "⚠️" : "✅") @hs.Label
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td @onclick:stopPropagation="true">
                                    <div class="action-btns">
                                        <button class="btn-action sm" @onclick="() => OpenForm(t)">Edit</button>
                                        @if (t.IsActive)
                                        {
                                            <button class="btn-action sm danger" @onclick="() => pendingDeactivate = t">Deactivate</button>
                                        }
                                        else
                                        {
                                            <button class="btn-action sm primary" @onclick="() => Activate(t.Id)">Activate</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (TotalPages > 1)
            {
                <div class="card-footer">
                    <span class="card-footer-info">
                        Page @currentPage of @TotalPages &nbsp;·&nbsp; @FilteredTenants.Count() tenants
                    </span>
                    <div class="card-footer-btns">
                        <button class="btn-action sm" disabled="@(currentPage <= 1)" @onclick="() => currentPage--">← Prev</button>
                        <button class="btn-action sm" disabled="@(currentPage >= TotalPages)" @onclick="() => currentPage++">Next →</button>
                    </div>
                </div>
            }
        }
    </div>

</div>

<!-- Tenant Modal -->
@if (showForm)
{
    <div class="modal-overlay" @onclick="() => showForm = false"></div>
    <div class="modal-sheet" @onclick="() => showForm = false">
        <div class="modal-box md" @onclick:stopPropagation="true">
            <div class="modal-top">
                <h2>@(editing.Id == 0 ? "Add Tenant" : "Edit Tenant")</h2>
                <button class="modal-close" @onclick="() => showForm = false">✕</button>
            </div>
            <div class="modal-body-inner">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="field-error">@formError</div>
                }
                <div class="form-stack">
                    <div class="field-row c2">
                        <div class="field-group">
                            <label class="field-label">First Name *</label>
                            <input class="field-input" @bind="editing.FirstName" placeholder="Jane" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Last Name *</label>
                            <input class="field-input" @bind="editing.LastName" placeholder="Smith" />
                        </div>
                    </div>
                    <div class="field-row c2">
                        <div class="field-group">
                            <label class="field-label">Email *</label>
                            <input class="field-input" type="email" @bind="editing.Email" placeholder="jane@example.com" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Phone</label>
                            <input class="field-input" @bind="editing.Phone" placeholder="+353 87 123 4567" />
                        </div>
                    </div>
                    <div class="field-row c2">
                        <div class="field-group">
                            <label class="field-label">Date of Birth</label>
                            <input class="field-input" type="date" @bind="editing.DateOfBirth" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Employer Name</label>
                            <input class="field-input" @bind="editing.EmployerName" placeholder="Acme Ltd." />
                        </div>
                    </div>
                    <div class="field-row c2">
                        <div class="field-group">
                            <label class="field-label">Employer Phone</label>
                            <input class="field-input" @bind="editing.EmployerPhone" placeholder="+353 1 234 5678" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Emergency Contact Name</label>
                            <input class="field-input" @bind="editing.EmergencyContactName" placeholder="John Smith" />
                        </div>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Emergency Contact Phone</label>
                        <input class="field-input" @bind="editing.EmergencyContactPhone" placeholder="+353 87 999 8888" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Notes</label>
                        <textarea class="field-input resize-v" rows="2" @bind="editing.Notes" placeholder="Any additional notes…"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn-cancel" @onclick="() => showForm = false">Cancel</button>
                <button class="btn-save" @onclick="Save">@(editing.Id == 0 ? "Add Tenant" : "Save Changes")</button>
            </div>
        </div>
    </div>
}

@if (pendingDeactivate != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block">
        <div class="modal-dialog modal-sm modal-dialog-top">
            <div class="modal-content">
                <div class="modal-header modal-header-clean">
                    <h5 class="modal-title text-red">Deactivate Tenant</h5>
                    <button type="button" class="btn-close" @onclick="() => pendingDeactivate = null"></button>
                </div>
                <div class="modal-body modal-body-tight">
                    <p class="mb-0">
                        Are you sure you want to deactivate <strong>@pendingDeactivate.FullName</strong>?
                        They will be marked as inactive but their records will be kept.
                    </p>
                </div>
                <div class="modal-footer modal-footer-clean">
                    <button class="btn btn-secondary" @onclick="() => pendingDeactivate = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="Deactivate">Yes, Deactivate</button>
                </div>
            </div>
        </div>
    </div>
}

@if (selectedTenant != null)
{
    <div class="side-panel-overlay" @onclick="ClosePanel"></div>

    <div class="side-panel">

        <div class="sp-hdr">
            <div class="user-initials lg">@selectedTenant.FirstName[0]@selectedTenant.LastName[0]</div>
            <div class="sp-hdr-info">
                <div class="sp-hdr-name">@selectedTenant.FullName</div>
                <div class="sp-hdr-sub">@selectedTenant.Email</div>
                @if (!string.IsNullOrEmpty(selectedTenant.Phone))
                {
                    <div class="text-muted">@selectedTenant.Phone</div>
                }
            </div>
            <button class="sp-close" @onclick="ClosePanel">✕</button>
        </div>

        @if (panelLoading)
        {
            <div class="panel-loader">
                <div class="spinner"></div>
            </div>
        }
        else
        {
            var hs = healthScores.GetValueOrDefault(selectedTenant.Id);
            if (hs != null)
            {
                <div class="sp-health-bar">
                    <span class="health-badge @(hs.Level == "Red" ? "red" : hs.Level == "Amber" ? "amber" : "green")">
                        @(hs.Level == "Red" ? "🔴" : hs.Level == "Amber" ? "⚠️" : "✅") @hs.Label
                    </span>
                    <span class="health-badge-reason">@hs.Reason</span>
                </div>
            }

            @if (panelLease != null)
            {
                <div class="sp-section">
                    <div class="section-label">Current Lease</div>
                    <div class="fw-700">@panelLease.Unit.Property.Name</div>
                    <div class="text-grey mb-10">Unit @panelLease.Unit.UnitNumber · @panelLease.Unit.Type</div>
                    <div class="info-grid">
                        <div class="info-tile">
                            <div class="info-tile-label">Monthly Rent</div>
                            <div class="info-tile-value">€@panelLease.MonthlyRent.ToString("N0")</div>
                        </div>
                        <div class="info-tile">
                            <div class="info-tile-label">Outstanding</div>
                            <div class="info-tile-value @(panelBalance > 0 ? "text-red" : "text-green")">
                                @(panelBalance > 0 ? $"€{panelBalance:N0}" : "Paid up")
                            </div>
                        </div>
                        <div class="info-tile">
                            <div class="info-tile-label">Lease Start</div>
                            <div class="info-tile-value">@panelLease.StartDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="info-tile">
                            <div class="info-tile-label">Lease End</div>
                            <div class="info-tile-value @((panelLease.EndDate - DateTime.Today).Days <= 60 ? "text-orange" : "")">
                                @panelLease.EndDate.ToString("dd MMM yyyy")
                                @if ((panelLease.EndDate - DateTime.Today).Days is >= 0 and <= 60)
                                {
                                    <span class="text-muted"> (@((panelLease.EndDate - DateTime.Today).Days)d)</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="sp-section">
                    <div class="section-label sm">Current Lease</div>
                    <div class="text-muted">No active lease</div>
                </div>
            }

            <div class="sp-section">
                <div class="section-label">Recent Payments</div>
                @if (!panelPayments.Any())
                {
                    <div class="text-muted">No payments recorded</div>
                }
                else
                {
                    @foreach (var p in panelPayments)
                    {
                        <div class="payment-row">
                            <div>
                                <div class="payment-row-amount">€@p.Amount.ToString("N2")</div>
                                <div class="payment-row-meta">@p.PaymentDate.ToString("dd MMM yyyy") · @p.PaymentMethod</div>
                            </div>
                            @if (p.OutstandingBalance > 0)
                            {
                                <span class="badge-owed">€@p.OutstandingBalance.ToString("N0") left</span>
                            }
                            else
                            {
                                <span class="badge-paid">Paid</span>
                            }
                        </div>
                    }
                }
            </div>

            <div class="sp-section last">
                <div class="section-label">Contact Details</div>
                @if (selectedTenant.DateOfBirth.HasValue)
                {
                    <div class="detail-row">
                        <span class="detail-key">Date of Birth</span>
                        <span class="detail-val">@selectedTenant.DateOfBirth.Value.ToString("dd MMM yyyy")</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedTenant.EmployerName))
                {
                    <div class="detail-row">
                        <span class="detail-key">Employer</span>
                        <span class="detail-val">@selectedTenant.EmployerName</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedTenant.EmployerPhone))
                {
                    <div class="detail-row">
                        <span class="detail-key">Employer Phone</span>
                        <span class="detail-val">@selectedTenant.EmployerPhone</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedTenant.EmergencyContactName))
                {
                    <div class="detail-row">
                        <span class="detail-key">Emergency Contact</span>
                        <span class="detail-val">@selectedTenant.EmergencyContactName</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedTenant.EmergencyContactPhone))
                {
                    <div class="detail-row">
                        <span class="detail-key">Emergency Phone</span>
                        <span class="detail-val">@selectedTenant.EmergencyContactPhone</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(selectedTenant.Notes))
                {
                    <div class="notes-box">@selectedTenant.Notes</div>
                }
            </div>
        }
    </div>
}

@code {
    bool loading = true, showForm, panelLoading;
    List<Tenant> tenants = new();
    Dictionary<int, TenantHealthScore> healthScores = new();
    Tenant  editing          = new();
    Tenant? pendingDeactivate;
    string successMsg = string.Empty, formError = string.Empty;
    string searchTerm = string.Empty, statusFilter = string.Empty, healthFilter = string.Empty;
    HashSet<int>? allowedIds;

    int currentPage = 1;
    const int PageSize = 10;

    Tenant? selectedTenant;
    Lease?  panelLease;
    decimal panelBalance;
    List<RentPayment> panelPayments = new();

    IEnumerable<Tenant> FilteredTenants => tenants.Where(t =>
        (string.IsNullOrWhiteSpace(searchTerm) || t.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || t.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(statusFilter)    || (statusFilter == "active" ? t.IsActive : !t.IsActive)) &&
        (string.IsNullOrEmpty(healthFilter)    || healthScores.GetValueOrDefault(t.Id)?.Level == healthFilter)
    );

    IEnumerable<Tenant> PagedTenants => FilteredTenants.Skip((currentPage - 1) * PageSize).Take(PageSize);
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredTenants.Count() / (double)PageSize));

    void ResetPage() => currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        allowedIds = await AccessService.GetAllowedIdsAsync(auth.User);
        tenants = await LoadTenants();
        healthScores = await TenantService.GetHealthScoresAsync(tenants.Select(t => t.Id));
        loading = false;
    }

    async Task<List<Tenant>> LoadTenants() =>
        allowedIds == null
            ? await TenantService.GetAllAsync()
            : await TenantService.GetByPropertyIdsAsync(allowedIds);

    async Task OpenPanel(Tenant t)
    {
        selectedTenant = t;
        panelLoading   = true;
        panelLease     = null;
        panelBalance   = 0;
        panelPayments  = new();

        var leases = await LeaseService.GetByTenantIdAsync(t.Id);
        panelLease = leases.FirstOrDefault(l => l.Status == LeaseStatus.Active)
                  ?? leases.FirstOrDefault();

        if (panelLease != null)
        {
            panelBalance  = await LeaseService.GetOutstandingBalanceAsync(panelLease.Id);
            panelPayments = await PaymentService.GetRecentByLeaseIdAsync(panelLease.Id);
        }

        panelLoading = false;
    }

    void ClosePanel() => selectedTenant = null;

    void OpenForm(Tenant? t = null)
    {
        editing = t != null
            ? new Tenant { Id = t.Id, FirstName = t.FirstName, LastName = t.LastName, Email = t.Email, Phone = t.Phone, DateOfBirth = t.DateOfBirth, EmployerName = t.EmployerName, EmployerPhone = t.EmployerPhone, EmergencyContactName = t.EmergencyContactName, EmergencyContactPhone = t.EmergencyContactPhone, Notes = t.Notes, IsActive = t.IsActive }
            : new Tenant();
        formError = string.Empty;
        showForm = true;
    }

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(editing.FirstName) || string.IsNullOrWhiteSpace(editing.LastName) || string.IsNullOrWhiteSpace(editing.Email))
        {
            formError = "First name, last name, and email are required.";
            return;
        }
        if (editing.Id == 0)
            await TenantService.CreateAsync(editing);
        else
            await TenantService.UpdateAsync(editing);

        showForm = false;
        successMsg = editing.Id == 0 ? "Tenant added." : "Tenant updated.";
        tenants = await LoadTenants();
        healthScores = await TenantService.GetHealthScoresAsync(tenants.Select(t => t.Id));
    }

    async Task Deactivate()
    {
        if (pendingDeactivate == null) return;
        await TenantService.DeactivateAsync(pendingDeactivate.Id);
        successMsg        = "Tenant deactivated.";
        pendingDeactivate = null;
        tenants      = await LoadTenants();
        healthScores = await TenantService.GetHealthScoresAsync(tenants.Select(t => t.Id));
    }

    async Task Activate(int id)
    {
        await TenantService.ActivateAsync(id);
        successMsg   = "Tenant activated.";
        tenants      = await LoadTenants();
        healthScores = await TenantService.GetHealthScoresAsync(tenants.Select(t => t.Id));
    }
}
