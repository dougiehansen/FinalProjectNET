@page "/reports"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator,PropertyManager,AccountingTeam")]
@inject IPropertyService PropertyService
@inject IReportService ReportService
@inject IJSRuntime JS
@inject IPropertyAccessService AccessService
@inject AuthenticationStateProvider AuthStateProvider
@using PropertyManagement.Models

<PageTitle>Reports - PropertyMS</PageTitle>

<div class="page-wrap">

    <div class="page-hdr">
        <div>
            <h1>Reports</h1>
            <p>Generate property management reports</p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="content-card panel" style="margin-bottom:20px;">
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:14px;">
            <div class="field-row c3">
                <div class="field-group">
                    <label class="field-label">Report Type</label>
                    <select class="field-select" @bind="selectedReport">
                        <option value="OccupancySummary">Occupancy Summary</option>
                        <option value="RentRoll">Rent Roll</option>
                        <option value="OutstandingPayments">Outstanding Payments</option>
                        <option value="ProfitLoss">Profit &amp; Loss</option>
                    </select>
                </div>
                <div class="field-group">
                    <label class="field-label">Property</label>
                    <select class="field-select" @bind="selectedPropertyId">
                        <option value="0">All Properties</option>
                        @foreach (var p in properties)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
                @if (selectedReport == "ProfitLoss")
                {
                    <div class="field-group">
                        <label class="field-label">Period From</label>
                        <input type="date" class="field-input" @bind="plFrom" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Period To</label>
                        <input type="date" class="field-input" @bind="plTo" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                }
                else
                {
                    <div class="field-group">
                        <label class="field-label">As of Date</label>
                        <input type="date" class="field-input" @bind="asOfDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                }
            </div>
            <div style="display:flex;gap:8px;">
                <button class="btn-save" @onclick="RunReport">Generate</button>
                @if (hasRun)
                {
                    <button class="btn-action" @onclick="ExportExcel" disabled="@exporting">
                        @if (exporting)
                        {
                            <span>Exporting…</span>
                        }
                        else
                        {
                            <svg width="14" height="14" fill="none" viewBox="0 0 14 14" style="margin-right:5px;vertical-align:middle;"><path d="M7 1v8M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>Export Excel</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div style="display:flex;justify-content:center;padding:40px;">
            <div class="spinner"></div>
        </div>
    }
    else if (hasRun)
    {
        <!-- Occupancy Summary -->
        @if (selectedReport == "OccupancySummary" && occupancyRows != null)
        {
            <div class="stats-grid g4" style="margin-bottom:20px;">
                <div class="stat-card">
                    <div class="stat-label">Properties</div>
                    <div class="stat-value">@occupancyRows.Count</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Total Units</div>
                    <div class="stat-value">@occupancyRows.Sum(r => r.TotalUnits)</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Avg Occupancy</div>
                    <div class="stat-value">@(occupancyRows.Any() ? (int)occupancyRows.Average(r => r.OccupancyRate) : 0)%</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Actual Revenue</div>
                    <div class="stat-value">€@occupancyRows.Sum(r => r.ActualRevenue).ToString("N0")</div>
                    <div class="stat-sub">of €@occupancyRows.Sum(r => r.PotentialRevenue).ToString("N0") potential</div>
                </div>
            </div>
            <div class="content-card">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Property</th>
                            <th>City</th>
                            <th>Total</th>
                            <th>Occupied</th>
                            <th>Vacant</th>
                            <th>Occupancy</th>
                            <th>Actual Revenue</th>
                            <th>Potential Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in occupancyRows)
                        {
                            <tr>
                                <td class="fw">@r.PropertyName</td>
                                <td>@r.PropertyCity</td>
                                <td>@r.TotalUnits</td>
                                <td style="color:var(--green)">@r.OccupiedUnits</td>
                                <td style="color:var(--orange)">@r.VacantUnits</td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <div class="occ-track" style="width:80px;">
                                            <div class="occ-fill" style="width:@(r.OccupancyRate)%"></div>
                                        </div>
                                        <span>@r.OccupancyRate%</span>
                                    </div>
                                </td>
                                <td>€@r.ActualRevenue.ToString("N0")</td>
                                <td style="color:var(--grey)">€@r.PotentialRevenue.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Rent Roll -->
        @if (selectedReport == "RentRoll" && rentRollRows != null)
        {
            <div class="stats-grid g3" style="margin-bottom:20px;">
                <div class="stat-card">
                    <div class="stat-label">Active Leases</div>
                    <div class="stat-value">@rentRollRows.Count</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Monthly Rent Roll</div>
                    <div class="stat-value">€@rentRollRows.Sum(r => r.MonthlyRent).ToString("N0")</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Expiring ≤ 60 Days</div>
                    <div class="stat-value" style="color:var(--orange)">@rentRollRows.Count(r => r.DaysLeft is >= 0 and <= 60)</div>
                </div>
            </div>
            <div class="content-card">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Property</th>
                            <th>Unit</th>
                            <th>Tenant</th>
                            <th>Monthly Rent</th>
                            <th>Lease Start</th>
                            <th>Lease End</th>
                            <th>Days Left</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rentRollRows)
                        {
                            <tr>
                                <td class="fw">@r.PropertyName</td>
                                <td>@r.UnitNumber</td>
                                <td>@r.TenantName</td>
                                <td>€@r.MonthlyRent.ToString("N2")</td>
                                <td>@r.LeaseStart.ToString("dd MMM yyyy")</td>
                                <td>@r.LeaseEnd.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (r.DaysLeft <= 0)
                                    {
                                        <span class="status-badge inactive">Expired</span>
                                    }
                                    else if (r.DaysLeft <= 60)
                                    {
                                        <span class="status-badge warning">@r.DaysLeft days</span>
                                    }
                                    else
                                    {
                                        <span>@r.DaysLeft days</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Outstanding Payments -->
        @if (selectedReport == "OutstandingPayments" && outstandingRows != null)
        {
            <div class="stats-grid g3" style="margin-bottom:20px;">
                <div class="stat-card">
                    <div class="stat-label">Tenants with Balance</div>
                    <div class="stat-value" style="color:var(--red)">@outstandingRows.Count</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Total Outstanding</div>
                    <div class="stat-value" style="color:var(--red)">€@outstandingRows.Sum(r => r.OutstandingBalance).ToString("N2")</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Avg Balance</div>
                    <div class="stat-value">€@(outstandingRows.Any() ? outstandingRows.Average(r => r.OutstandingBalance).ToString("N2") : "0.00")</div>
                </div>
            </div>
            @if (!outstandingRows.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">✅</div>
                    <h3>No outstanding balances</h3>
                    <p>All tenants are up to date with payments.</p>
                </div>
            }
            else
            {
                <div class="content-card">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Tenant</th>
                                <th>Property</th>
                                <th>Unit</th>
                                <th>Monthly Rent</th>
                                <th>Outstanding Balance</th>
                                <th>Lease End</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in outstandingRows)
                            {
                                <tr>
                                    <td class="fw">@r.TenantName</td>
                                    <td>@r.PropertyName</td>
                                    <td>@r.UnitNumber</td>
                                    <td>€@r.MonthlyRent.ToString("N2")</td>
                                    <td style="color:var(--red);font-weight:700;">€@r.OutstandingBalance.ToString("N2")</td>
                                    <td>@r.LeaseEnd.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        <!-- Profit & Loss -->
        @if (selectedReport == "ProfitLoss" && profitLossRows != null)
        {
            var totalRevenue  = profitLossRows.Sum(r => r.RentRevenue);
            var totalExpenses = profitLossRows.Sum(r => r.TotalExpenses);
            var netIncome     = totalRevenue - totalExpenses;
            <div class="stats-grid g3" style="margin-bottom:20px;">
                <div class="stat-card">
                    <div class="stat-label">Rent Revenue</div>
                    <div class="stat-value" style="color:#16a34a;">€@totalRevenue.ToString("N0")</div>
                    <div class="stat-sub">collected in period</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Total Expenses</div>
                    <div class="stat-value" style="color:#dc2626;">€@totalExpenses.ToString("N0")</div>
                    <div class="stat-sub">across all categories</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Net Income</div>
                    <div class="stat-value" style="color:@(netIncome >= 0 ? "#16a34a" : "#dc2626");">€@netIncome.ToString("N0")</div>
                    <div class="stat-sub">@(netIncome >= 0 ? "profit" : "loss")</div>
                </div>
            </div>
            @if (!profitLossRows.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">📊</div>
                    <h3>No data for this period</h3>
                    <p>No rent payments or expenses found between @plFrom.ToString("dd MMM yyyy") and @plTo.ToString("dd MMM yyyy").</p>
                </div>
            }
            else
            {
                <div class="content-card">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Property</th>
                                <th>Rent Revenue</th>
                                <th>Total Expenses</th>
                                <th>Net Income</th>
                                <th>Margin</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in profitLossRows)
                            {
                                var margin = r.RentRevenue > 0 ? (int)Math.Round(r.NetIncome / r.RentRevenue * 100) : 0;
                                <tr>
                                    <td class="fw">@r.PropertyName</td>
                                    <td style="color:#16a34a;font-weight:600;">€@r.RentRevenue.ToString("N0")</td>
                                    <td style="color:#dc2626;">€@r.TotalExpenses.ToString("N0")</td>
                                    <td style="font-weight:700;color:@(r.NetIncome >= 0 ? "#16a34a" : "#dc2626");">€@r.NetIncome.ToString("N0")</td>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            <div class="occ-track" style="width:80px;">
                                                <div class="occ-fill" style="width:@(Math.Max(0, Math.Min(100, margin)))%;background:@(margin >= 0 ? "#16a34a" : "#dc2626");"></div>
                                            </div>
                                            <span style="color:@(margin >= 0 ? "#16a34a" : "#dc2626");">@margin%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="font-weight:700;border-top:2px solid #e5e7eb;">
                                <td>Total</td>
                                <td style="color:#16a34a;">€@totalRevenue.ToString("N0")</td>
                                <td style="color:#dc2626;">€@totalExpenses.ToString("N0")</td>
                                <td style="color:@(netIncome >= 0 ? "#16a34a" : "#dc2626");">€@netIncome.ToString("N0")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        }

    }

</div>

@code {
    bool loading, hasRun, exporting;
    string selectedReport = "OccupancySummary";
    int selectedPropertyId;
    DateTime asOfDate = DateTime.Today;
    DateTime plFrom   = new DateTime(DateTime.Today.Year, 1, 1);
    DateTime plTo     = DateTime.Today;
    List<Property> properties = new();

    List<OccupancyRow>?          occupancyRows;
    List<RentRollRow>?           rentRollRows;
    List<OutstandingPaymentRow>? outstandingRows;
    List<ProfitLossRow>?         profitLossRows;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var allowedIds = await AccessService.GetAllowedIdsAsync(auth.User);
        var all = await PropertyService.GetAllAsync();
        properties = allowedIds == null ? all : all.Where(p => allowedIds.Contains(p.Id)).ToList();
    }

    async Task RunReport()
    {
        loading = true;
        occupancyRows   = null;
        rentRollRows    = null;
        outstandingRows = null;
        profitLossRows  = null;

        var queryDate = asOfDate == DateTime.Today ? (DateTime?)null : asOfDate;

        switch (selectedReport)
        {
            case "OccupancySummary":
                occupancyRows = await ReportService.GetOccupancySummaryAsync(selectedPropertyId, queryDate);
                break;
            case "RentRoll":
                rentRollRows = await ReportService.GetRentRollAsync(selectedPropertyId, queryDate);
                break;
            case "OutstandingPayments":
                outstandingRows = await ReportService.GetOutstandingPaymentsAsync(selectedPropertyId, queryDate);
                break;
            case "ProfitLoss":
                profitLossRows = await ReportService.GetProfitLossAsync(selectedPropertyId, plFrom, plTo);
                break;
        }

        loading = false;
        hasRun  = true;
    }

    async Task ExportExcel()
    {
        exporting = true;
        var queryDate = asOfDate == DateTime.Today ? (DateTime?)null : asOfDate;
        var bytes     = await ReportService.ExportToExcelAsync(selectedReport, selectedPropertyId, queryDate, plFrom, plTo);
        var base64    = Convert.ToBase64String(bytes);
        var filename  = selectedReport == "ProfitLoss"
            ? $"ProfitLoss_{plFrom:yyyyMMdd}_to_{plTo:yyyyMMdd}.xlsx"
            : $"{selectedReport}_{asOfDate:yyyyMMdd}.xlsx";
        await JS.InvokeVoidAsync("downloadFile", filename, base64);
        exporting = false;
    }

}
