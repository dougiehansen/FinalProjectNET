@page "/maintenance"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IMaintenanceService MaintenanceService
@inject IPropertyService PropertyService
@inject IUnitService UnitService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@using PropertyManagement.Models

<PageTitle>Maintenance - PropertyMS</PageTitle>

<div class="page-wrap">

    <!-- Page header -->
    <div class="page-hdr">
        <div>
            <h1>Maintenance</h1>
            <p>@allRequests.Count @(allRequests.Count == 1 ? "work order" : "work orders") &nbsp;·&nbsp; @allRequests.Count(r => r.Status == MaintenanceStatus.Open) open</p>
        </div>
        <AuthorizeView Roles="Administrator,PropertyManager,MaintenanceStaff">
            <button class="btn-primary-action" @onclick="OpenSubmitForm">
                <svg width="14" height="14" fill="none" viewBox="0 0 14 14">
                    <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Submit Request
            </button>
        </AuthorizeView>
    </div>

    <!-- Stats strip -->
    <div class="stats-grid g4">
        <div class="stat-card">
            <div class="stat-label">Open</div>
            <div class="stat-value">@allRequests.Count(r => r.Status == MaintenanceStatus.Open)</div>
            <div class="stat-sub">Awaiting assignment</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Assigned / In Progress</div>
            <div class="stat-value">@allRequests.Count(r => r.Status == MaintenanceStatus.Assigned || r.Status == MaintenanceStatus.InProgress)</div>
            <div class="stat-sub">Active work orders</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Completed</div>
            <div class="stat-value">@allRequests.Count(r => r.Status == MaintenanceStatus.Completed)</div>
            <div class="stat-sub">Resolved</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Emergency</div>
            <div class="stat-value">@allRequests.Count(r => r.UrgencyLevel == UrgencyLevel.Emergency && r.Status != MaintenanceStatus.Completed)</div>
            <div class="stat-sub">Urgent open issues</div>
        </div>
    </div>

    <!-- Success alert -->
    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div class="alert-banner success">
            <span>@successMsg</span>
            <button class="btn-action sm" @onclick="() => successMsg = string.Empty">✕</button>
        </div>
    }

    <!-- Status filter: segmented control -->
    <div class="seg" style="width:fit-content;margin-bottom:16px;">
        <button class="seg-btn @(statusFilter == null ? "active" : "")" @onclick="() => SetFilter(null)">All</button>
        @foreach (var s in Enum.GetValues<MaintenanceStatus>())
        {
            <button class="seg-btn @(statusFilter == s ? "active" : "")" @onclick="() => SetFilter(s)">@s</button>
        }
    </div>

    <!-- Work orders table -->
    <div class="content-card panel">
        @if (loading)
        {
            <div style="display:flex;justify-content:center;padding:32px;">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (!FilteredRequests.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">🔧</div>
                <h3>No work orders found</h3>
                <p>@(statusFilter == null ? "Submit a request to get started." : $"No {statusFilter} requests.")</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Title</th>
                            <th>Property / Unit</th>
                            <th>Urgency</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th>Submitted</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in FilteredRequests)
                        {
                            <tr>
                                <td style="color:var(--grey);font-size:0.85rem;">#@m.Id</td>
                                <td><strong>@m.Title</strong></td>
                                <td style="color:var(--grey);font-size:0.9rem;">@m.Property.Name – @m.Unit.UnitNumber</td>
                                <td><span class="status-badge @GetUrgencyClass(m.UrgencyLevel)">@m.UrgencyLevel</span></td>
                                <td><span class="status-badge @GetStatusClass(m.Status)">@m.Status</span></td>
                                <td style="color:var(--grey);font-size:0.9rem;">@(m.AssignedTo?.FullName ?? "–")</td>
                                <td style="color:var(--grey);font-size:0.85rem;">@m.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="action-btns">
                                        <button class="btn-action sm" @onclick="() => OpenDetailModal(m)">View</button>
                                        <AuthorizeView Roles="Administrator,PropertyManager">
                                            @if (m.Status == MaintenanceStatus.Open)
                                            {
                                                <button class="btn-action sm" @onclick="() => OpenAssignModal(m)">Assign</button>
                                            }
                                        </AuthorizeView>
                                        <AuthorizeView Roles="MaintenanceStaff,Administrator,PropertyManager">
                                            @if (m.Status == MaintenanceStatus.Assigned || m.Status == MaintenanceStatus.InProgress)
                                            {
                                                <button class="btn-action sm" @onclick="() => OpenUpdateModal(m)">Update</button>
                                            }
                                        </AuthorizeView>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

<!-- Submit Request Modal -->
@if (showSubmitForm)
{
    <div class="modal-overlay" @onclick="() => showSubmitForm = false"></div>
    <div class="modal-sheet" @onclick="() => showSubmitForm = false">
        <div class="modal-box" style="max-width:640px;" @onclick:stopPropagation="true">
            <div class="modal-top">
                <h2>Submit Maintenance Request</h2>
                <button class="modal-close" @onclick="() => showSubmitForm = false">✕</button>
            </div>
            <div class="modal-body-inner">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="field-error">@formError</div>
                }
                <div style="display:flex;flex-direction:column;gap:14px;">
                    <div class="field-row c2">
                        <div class="field-group">
                            <label class="field-label">Property *</label>
                            <select class="field-select" value="@newRequest.PropertyId" @onchange="OnPropertySelected">
                                <option value="0">Select property…</option>
                                @foreach (var p in allProperties)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Unit *</label>
                            <select class="field-select" @bind="newRequest.UnitId" disabled="@(unitsForProperty.Count == 0)">
                                <option value="0">@(newRequest.PropertyId == 0 ? "Select property first…" : "Select unit…")</option>
                                @foreach (var u in unitsForProperty)
                                {
                                    <option value="@u.Id">@u.UnitNumber</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Title *</label>
                        <input class="field-input" @bind="newRequest.Title" placeholder="Brief description of the issue" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Description *</label>
                        <textarea class="field-input" rows="3" @bind="newRequest.Description" placeholder="Detailed description of the issue" style="resize:vertical;"></textarea>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Urgency Level</label>
                        <select class="field-select" @bind="newRequest.UrgencyLevel">
                            @foreach (var u in Enum.GetValues<UrgencyLevel>())
                            {
                                <option value="@u">@u</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn-cancel" @onclick="() => showSubmitForm = false">Cancel</button>
                <button class="btn-save" @onclick="SubmitRequest">Submit Request</button>
            </div>
        </div>
    </div>
}

<!-- Assign Modal -->
@if (showAssignModal && selectedRequest != null)
{
    <div class="modal-overlay" @onclick="() => showAssignModal = false"></div>
    <div class="modal-sheet" @onclick="() => showAssignModal = false">
        <div class="modal-box" style="max-width:520px;" @onclick:stopPropagation="true">
            <div class="modal-top">
                <h2>Assign Work Order</h2>
                <button class="modal-close" @onclick="() => showAssignModal = false">✕</button>
            </div>
            <div class="modal-body-inner">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="field-error">@formError</div>
                }
                <p style="font-size:0.88rem;color:var(--grey);margin-bottom:14px;">Work Order: <strong>@selectedRequest.Title</strong></p>
                <div style="display:flex;flex-direction:column;gap:14px;">
                    <div class="field-group">
                        <label class="field-label">Assign To *</label>
                        <select class="field-select" @bind="assignToUserId">
                            <option value="0">Select staff member…</option>
                            @foreach (var s in maintenanceStaff)
                            {
                                <option value="@s.Id">@s.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Priority</label>
                        <select class="field-select" @bind="assignPriority">
                            <option>Low</option>
                            <option>Normal</option>
                            <option>High</option>
                            <option>Urgent</option>
                        </select>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Assignment Notes</label>
                        <textarea class="field-input" rows="2" @bind="assignNotes" style="resize:vertical;"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn-cancel" @onclick="() => showAssignModal = false">Cancel</button>
                <button class="btn-save" @onclick="AssignRequest">Confirm Assignment</button>
            </div>
        </div>
    </div>
}

<!-- Update Status Modal -->
@if (showUpdateModal && selectedRequest != null)
{
    <div class="modal-overlay" @onclick="() => showUpdateModal = false"></div>
    <div class="modal-sheet" @onclick="() => showUpdateModal = false">
        <div class="modal-box" style="max-width:580px;" @onclick:stopPropagation="true">
            <div class="modal-top">
                <h2>Update Work Order</h2>
                <button class="modal-close" @onclick="() => showUpdateModal = false">✕</button>
            </div>
            <div class="modal-body-inner">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="field-error">@formError</div>
                }
                <p style="font-size:0.88rem;color:var(--grey);margin-bottom:14px;">Work Order: <strong>@selectedRequest.Title</strong></p>
                <div style="display:flex;flex-direction:column;gap:14px;">
                    <div class="field-group">
                        <label class="field-label">Status</label>
                        <select class="field-select" @bind="selectedRequest.Status">
                            <option value="@MaintenanceStatus.InProgress">In Progress</option>
                            <option value="@MaintenanceStatus.Completed">Completed</option>
                        </select>
                    </div>
                    @if (selectedRequest.Status == MaintenanceStatus.Completed)
                    {
                        <div class="field-row c2">
                            <div class="field-group">
                                <label class="field-label">Completion Date *</label>
                                <input class="field-input" type="date" @bind="selectedRequest.CompletionDate" />
                            </div>
                            <div class="field-group">
                                <label class="field-label">Estimated Cost (€)</label>
                                <input class="field-input" type="number" @bind="selectedRequest.EstimatedCost" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Materials Used</label>
                            <input class="field-input" @bind="selectedRequest.MaterialsUsed" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Completion Notes</label>
                            <textarea class="field-input" rows="2" @bind="selectedRequest.CompletionNotes" style="resize:vertical;"></textarea>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn-cancel" @onclick="() => showUpdateModal = false">Cancel</button>
                <button class="btn-save" @onclick="UpdateStatus">Save Update</button>
            </div>
        </div>
    </div>
}

<!-- View Detail Modal -->
@if (showDetailModal && selectedRequest != null)
{
    <div class="modal-overlay" @onclick="() => showDetailModal = false"></div>
    <div class="modal-sheet" @onclick="() => showDetailModal = false">
        <div class="modal-box" style="max-width:560px;" @onclick:stopPropagation="true">
            <div class="modal-blue-hdr">
                <div>
                    <h3>Work Order #@selectedRequest.Id</h3>
                    <p>@selectedRequest.Property.Name – @selectedRequest.Unit.UnitNumber</p>
                </div>
                <button class="modal-blue-close" @onclick="() => showDetailModal = false">✕</button>
            </div>
            <div class="modal-body-inner">
                <div class="modal-detail-row"><span>Title</span><span>@selectedRequest.Title</span></div>
                <div class="modal-detail-row"><span>Description</span><span>@selectedRequest.Description</span></div>
                <div class="modal-detail-row"><span>Urgency</span><span><span class="status-badge @GetUrgencyClass(selectedRequest.UrgencyLevel)">@selectedRequest.UrgencyLevel</span></span></div>
                <div class="modal-detail-row"><span>Status</span><span><span class="status-badge @GetStatusClass(selectedRequest.Status)">@selectedRequest.Status</span></span></div>
                <div class="modal-detail-row"><span>Submitted By</span><span>@selectedRequest.SubmittedBy.FullName</span></div>
                <div class="modal-detail-row"><span>Assigned To</span><span>@(selectedRequest.AssignedTo?.FullName ?? "Unassigned")</span></div>
                <div class="modal-detail-row"><span>Priority</span><span>@(string.IsNullOrEmpty(selectedRequest.Priority) ? "–" : selectedRequest.Priority)</span></div>
                @if (!string.IsNullOrEmpty(selectedRequest.AssignmentNotes))
                {
                    <div class="modal-detail-row"><span>Assignment Notes</span><span>@selectedRequest.AssignmentNotes</span></div>
                }
                @if (selectedRequest.Status == MaintenanceStatus.Completed)
                {
                    <div class="modal-detail-row"><span>Completed</span><span>@selectedRequest.CompletionDate?.ToString("dd MMM yyyy")</span></div>
                    <div class="modal-detail-row"><span>Cost</span><span>@(selectedRequest.EstimatedCost.HasValue ? $"€{selectedRequest.EstimatedCost:N2}" : "–")</span></div>
                    <div class="modal-detail-row"><span>Materials</span><span>@(string.IsNullOrEmpty(selectedRequest.MaterialsUsed) ? "–" : selectedRequest.MaterialsUsed)</span></div>
                    <div class="modal-detail-row"><span>Completion Notes</span><span>@(string.IsNullOrEmpty(selectedRequest.CompletionNotes) ? "–" : selectedRequest.CompletionNotes)</span></div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn-cancel" @onclick="() => showDetailModal = false">Close</button>
            </div>
        </div>
    </div>
}

@code {
    bool loading = true, showSubmitForm, showAssignModal, showUpdateModal, showDetailModal;
    List<MaintenanceRequest> allRequests  = new();
    List<Property> allProperties          = new();
    List<Unit> unitsForProperty           = new();
    List<User> maintenanceStaff           = new();
    MaintenanceRequest newRequest         = new();
    MaintenanceRequest? selectedRequest;
    MaintenanceStatus? statusFilter;
    int assignToUserId, currentUserId;
    string assignPriority = "Normal", assignNotes = string.Empty;
    string successMsg = string.Empty, formError = string.Empty;
    string currentRole = string.Empty;

    IEnumerable<MaintenanceRequest> FilteredRequests =>
        statusFilter == null ? allRequests : allRequests.Where(r => r.Status == statusFilter);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out currentUserId);
        currentRole = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

        await LoadData();
        allProperties    = await PropertyService.GetAllAsync();
        maintenanceStaff = await UserService.GetByRoleAsync(UserRole.MaintenanceStaff);
        loading          = false;
    }

    async Task LoadData()
    {
        // MaintenanceStaff only see their own assigned jobs; admins and managers see all
        allRequests = currentRole == "MaintenanceStaff"
            ? await MaintenanceService.GetAssignedToAsync(currentUserId)
            : await MaintenanceService.GetAllAsync();
    }

    void SetFilter(MaintenanceStatus? s) => statusFilter = s;

    void OpenSubmitForm()
    {
        newRequest       = new MaintenanceRequest { UrgencyLevel = UrgencyLevel.Medium };
        unitsForProperty = new();
        formError        = string.Empty;
        showSubmitForm   = true;
    }

    async Task OnPropertySelected(ChangeEventArgs e)
    {
        newRequest.PropertyId = int.Parse(e.Value?.ToString() ?? "0");
        unitsForProperty = newRequest.PropertyId > 0
            ? await UnitService.GetByPropertyAsync(newRequest.PropertyId)
            : new();
        newRequest.UnitId = 0;
    }

    async Task SubmitRequest()
    {
        if (newRequest.PropertyId == 0 || newRequest.UnitId == 0 ||
            string.IsNullOrWhiteSpace(newRequest.Title) || string.IsNullOrWhiteSpace(newRequest.Description))
        {
            formError = "Property, unit, title, and description are required.";
            return;
        }

        newRequest.SubmittedByUserId = currentUserId;
        await MaintenanceService.CreateAsync(newRequest);
        showSubmitForm = false;
        successMsg     = "Maintenance request submitted.";
        await LoadData();
    }

    void OpenAssignModal(MaintenanceRequest m)
    {
        selectedRequest = m;
        assignToUserId  = 0;
        assignPriority  = "Normal";
        assignNotes     = string.Empty;
        formError       = string.Empty;
        showAssignModal = true;
    }

    async Task AssignRequest()
    {
        if (assignToUserId == 0)
        {
            formError = "Please select a staff member.";
            return;
        }
        await MaintenanceService.AssignAsync(selectedRequest!.Id, assignToUserId, assignPriority, assignNotes);
        showAssignModal = false;
        successMsg      = "Work order assigned successfully.";
        await LoadData();
    }

    void OpenUpdateModal(MaintenanceRequest m)
    {
        // Copy into a new object so edits in the modal don't mutate the table row directly
        selectedRequest = new MaintenanceRequest
        {
            Id = m.Id, Title = m.Title, Status = m.Status,
            Property = m.Property, Unit = m.Unit,
            SubmittedBy = m.SubmittedBy, AssignedTo = m.AssignedTo,
            Description = m.Description, UrgencyLevel = m.UrgencyLevel,
            Priority = m.Priority, AssignmentNotes = m.AssignmentNotes,
            CompletionDate = m.CompletionDate, MaterialsUsed = m.MaterialsUsed,
            EstimatedCost = m.EstimatedCost, CompletionNotes = m.CompletionNotes
        };
        formError        = string.Empty;
        showUpdateModal  = true;
    }

    async Task UpdateStatus()
    {
        if (selectedRequest!.Status == MaintenanceStatus.Completed && !selectedRequest.CompletionDate.HasValue)
        {
            formError = "Completion date is required when marking as completed.";
            return;
        }
        await MaintenanceService.UpdateAsync(selectedRequest!);
        showUpdateModal = false;
        successMsg      = "Work order updated.";
        await LoadData();
    }

    void OpenDetailModal(MaintenanceRequest m)
    {
        selectedRequest  = m;
        showDetailModal  = true;
    }

    /// <summary>
    /// Maps MaintenanceStatus to a theme.css status-badge modifier class.
    /// </summary>
    string GetStatusClass(MaintenanceStatus s) => s switch
    {
        MaintenanceStatus.Open       => "terminated",
        MaintenanceStatus.Assigned   => "warning",
        MaintenanceStatus.InProgress => "info",
        MaintenanceStatus.Completed  => "active",
        MaintenanceStatus.Cancelled  => "expired",
        _                            => "expired"
    };

    /// <summary>
    /// Maps UrgencyLevel to a theme.css status-badge modifier class.
    /// </summary>
    string GetUrgencyClass(UrgencyLevel u) => u switch
    {
        UrgencyLevel.Emergency => "terminated",
        UrgencyLevel.High      => "warning",
        UrgencyLevel.Medium    => "info",
        UrgencyLevel.Low       => "expired",
        _                      => "expired"
    };
}
